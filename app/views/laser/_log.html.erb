<%= form_with url: laser_path, method: :get, data: { controller: "autosubmit" }, class: "laser-log-filters" do |f| %>
  <%= f.hidden_field :view, value: "log" %>
  <%= f.select :log, options_for_select(@logs.invert, params[:log]), { include_blank: "Both logs" }, "aria-label": "Log", data: { action: "change->autosubmit#submit" } %>
  <%= f.search_field :q, value: params[:q], placeholder: "Search project and notes", "aria-label": "Search" %>
  <%= f.select :material, options_for_select(@materials, params[:material]), { include_blank: "Any material" }, "aria-label": "Material", data: { action: "change->autosubmit#submit" } %>
  <%= f.select :result, options_for_select([["Worked", "success"], ["Partly worked", "conditional"], ["Failed", "fail"]], params[:result]), { include_blank: "Any result" }, "aria-label": "Result", data: { action: "change->autosubmit#submit" } %>
  <%= f.submit "Search", class: "btn" %>
<% end %>
<p class="label"><%= pluralize(number_with_delimiter(@found), "job") %>, newest first. Names on the form are not shown. The earlier log (2013 to 2020) recorded settings only: no project, notes or result.</p>
<div class="table-wrap card">
  <table class="laser-table">
    <thead><tr><th>Date</th><th>Job</th><th>Material</th><th>Settings</th><th>Result</th></tr></thead>
    <tbody>
      <% @log.each do |job| %>
        <% note = [@settings.free_result(job), job.notes, job.machine_notes, job.software_notes].compact_blank.join(" / ") %>
        <tr>
          <td class="nowrap"><%= job.date.iso8601 %></td>
          <td><% if job.source == LaserJob::EARLIER %><span class="muted">Earlier log</span><% else %><strong><%= job.title %></strong><% end %><% if note.present? %><br><span class="muted small"><%= truncate(note, length: 220) %></span><% end %></td>
          <td><%= job.material %><br><span class="muted small"><%= job.bucket %><%= " (logged as #{job.material_raw})" if job.source == LaserJob::EARLIER && job.material_raw.present? && job.material_raw.downcase != job.material.downcase %></span></td>
          <td class="nowrap"><%= "#{job.cut_op} #{laser_number(job.cut_power)}/#{laser_number(job.cut_speed)}" if job.cut_op %><% if job.cut_op && job.eng_mode %><br><% end %><%= "engrave #{laser_number(job.eng_power)}/#{laser_number(job.eng_speed)}" if job.eng_mode %></td>
          <td><%= render ChipComponent.new({ "success" => "worked", "conditional" => "partly", "fail" => "failed", "unknown" => "not recorded" }.fetch(job.result, job.result), tone: { "success" => :ok, "conditional" => :warn, "fail" => :err }[job.result]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% if @found > @shown %>
  <p><%= link_to "Show #{LaserController::LOG_PAGE} more", laser_path(view: "log", log: params[:log], q: params[:q], material: params[:material], result: params[:result], shown: @shown + LaserController::LOG_PAGE), class: "btn" %></p>
<% end %>
<details class="card laser-more">
  <summary>How the log was cleaned</summary>
  <p class="muted">The forms accepted anything, so the site repairs what it can when it reads both logs and records each repair. A value it cannot trust is left blank for that job.</p>
  <div class="table-wrap"><table><thead><tr><th>Repair</th><th class="num">Jobs</th></tr></thead><tbody>
    <% (@earlier + @jobs).flat_map(&:fixes).tally.sort_by { |_fix, n| -n }.each do |fix, n| %><tr><td><%= fix %></td><td class="num"><%= n %></td></tr><% end %>
  </tbody></table></div>
</details>
