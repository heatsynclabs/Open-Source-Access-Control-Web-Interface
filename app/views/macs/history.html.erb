<%
  # The controller builds Highcharts-style [milliseconds, count] pairs (also
  # served as JSON); Chartkick takes time => count.
  computers_by_hour = @mac_log_graph.to_h { |ms, count| [time_from_js(ms), count] }
%>
<%= render PageHeaderComponent.new(eyebrow: "Computers", eyebrow_path: macs_path, title: "Computers over time") do |header| %>
  <% header.with_action { link_to "Download JSON", macs_history_path + ".json", class: "btn" } %>
<% end %>

<%= form_tag(nil, method: :get, class: "inline-form") do %>
  <%= render "shared/date_range", from_label: "From" %>
  <%= submit_tag "Show", name: nil, class: "primary" %>
<% end %>

<%= render ChartCardComponent.new(title: "Computers on the network, by hour",
      note: "These numbers are estimates: they are worked out from join and leave events each time the page loads, so they can shift with the dates chosen.") do %>
  <% if computers_by_hour.any? %>
    <%= line_chart computers_by_hour, curve: false, points: false, height: "360px", ytitle: "Computers" %>
  <% else %>
    <%= render EmptyStateComponent.new("No activity data for these dates.") %>
  <% end %>
<% end %>
