<%= form_for(@mac, html: { class: "form" }) do |f| %>
  <%= render FormErrorsComponent.new(@mac) %>
  <fieldset>
    <legend>Computer</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :user_id, "Owner" %>
        <%= collection_select(:mac, :user_id, @users, :id, :name, include_blank: true) %>
      </div>
      <div class="field">
        <%= f.label :mac, "MAC address" %>
        <%= f.text_field :mac, value: (@mac.mac || @arp || nil), class: "mono", autocomplete: "off" %>
        <% if @arp.present? %>
          <p class="hint">Found from your IP address, <%= @ip %>.</p>
        <% else %>
          <p class="hint">Six pairs of hex digits, like 00:1a:2b:3c:4d:5e.</p>
        <% end %>
      </div>
      <div class="field wide">
        <%= f.label :note %>
        <%= f.text_field :note %>
        <p class="hint">Which machine this is.</p>
      </div>
    </div>
    <div class="check">
      <%= f.check_box :hidden %>
      <%= f.label :hidden, "Hide this computer from the public list" %>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit @mac.new_record? ? "Register computer" : "Save computer", class: "primary" %>
    <%= link_to "Cancel", macs_path, class: "btn" %>
  </div>
<% end %>
