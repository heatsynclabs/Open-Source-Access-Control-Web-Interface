<%
  # What the hover text shows depends on who is looking, as before: the MAC
  # for members, the IP for people who may see details, hours here for admins.
  mac_details = lambda do |mac|
    [
      (mac.mac if user_signed_in?),
      (mac.ip.to_s if can? :read_details, mac),
      ("#{((Time.now - mac.since) / 1.hour).round(1)} hours" if can?(:manage, mac) && mac.since),
    ].compact.join("  -  ")
  end
%>
<%= render PageHeaderComponent.new(eyebrow: "Computers", title: "Who is on the network", lead: "Computers seen on the lab network right now. Register yours to show up by name.") do |header| %>
  <% header.with_action { link_to "Register a computer", new_mac_path, class: "btn primary" } if can? :create, Mac %>
  <% header.with_action { link_to "Activity graph", macs_history_path, class: "btn" } if can? :read_details, Mac %>
<% end %>

<% if can?(:read_details, Mac) && @mac_time_start_date.present? %>
  <div class="tiles">
    <%= render StatTileComponent.new(value: @active_macs.length, label: "Here now", tone: :headline) %>
    <% [[@most_active_mac, @most_active, "Most active"], [@runner_up_mac, @runner_up, "Runner up"]].each do |mac, entry, label| %>
      <% next unless mac && entry %>
      <%= render StatTileComponent.new(value: "#{(entry.last[:time] / 1.hour).round} hrs",
            label: "#{label}, last #{distance_of_time_in_words(DateTime.now, @mac_time_start_date)}",
            sub: render(Admin::MacLabelComponent.new(mac: mac, details: mac_details.call(mac)))) %>
    <% end %>
  </div>
<% end %>

<div class="grid side">
  <section class="card">
    <div class="card-head"><h2>Here now</h2><span class="muted small"><%= pluralize(@active_macs.length, "computer") %></span></div>
    <% if @active_macs.any? %>
      <ul class="plain">
        <% @active_macs.each do |mac| %>
          <li>
            <% if user_signed_in? %>
              <%= link_to mac do %><%= render Admin::MacLabelComponent.new(mac: mac, details: mac_details.call(mac)) %><% end %>
            <% else %>
              <%= render Admin::MacLabelComponent.new(mac: mac) %>
            <% end %>
            <%= link_to "Edit", edit_mac_path(mac), class: "btn small" if can? :update, mac %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= render EmptyStateComponent.new("Nobody's computer is on the network right now.") %>
    <% end %>
    <% unless can? :read_details, Mac %>
      <p class="note">Sign in to see more, or to register your own computer.</p>
    <% end %>
  </section>

  <% if can? :read_details, Mac %>
    <section class="card">
      <div class="card-head"><h2>Here, hidden</h2><span class="muted small"><%= @hidden_macs.size %></span></div>
      <% if @hidden_macs.any? %>
        <ul class="plain">
          <% @hidden_macs.each do |mac| %>
            <li>
              <%= render Admin::MacLabelComponent.new(mac: mac, details: mac_details.call(mac)) %>
              <%= link_to "Edit", edit_mac_path(mac), class: "btn small" if can? :update, mac %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render EmptyStateComponent.new("No hidden computers are here.") %>
      <% end %>
    </section>
  <% end %>
</div>

<% if can? :manage, Mac %>
  <section class="all-macs">
    <h2>All registered computers</h2>
    <div data-controller="filter" data-filter-noun-value="computers">
      <div class="filters">
        <%= render "shared/search", placeholder: "MAC, owner or note", label: "Search computers" %>
        <button type="button" class="toggle" data-filter-target="toggle" data-key="here" aria-pressed="false" data-action="filter#flip">Here now</button>
      </div>
      <p class="count-line" data-filter-target="count" aria-live="polite"></p>
      <div class="table-wrap tall">
        <table>
          <thead>
            <tr><th>MAC</th><th>Owner</th><th>Note</th><th>Status</th><th class="num">Hours since change</th><th><span class="visually-hidden">Actions</span></th></tr>
          </thead>
          <tbody>
            <% @all_macs.each do |mac| %>
              <tr class="<%= 'tone-quiet' if mac.hidden? %>" data-filter-target="item" data-here="<%= mac.active? %>"
                  data-filter-text="<%= [mac.mac, mac.user&.name, mac.note].compact.join(' ') %>">
                <td class="mono"><%= mac.mac.downcase %></td>
                <td><%= mac.user.name if mac.user %></td>
                <td class="wrap"><%= mac.note %></td>
                <td>
                  <%= mac.active? ? render(ChipComponent.new("Here", tone: :ok, dot: true)) : render(ChipComponent.new("Gone")) %>
                  <%= render ChipComponent.new("Hidden") if mac.hidden? %>
                </td>
                <td class="num"><%= ((Time.now - mac.since) / 1.hour).round(1) if mac.since %></td>
                <td class="actions"><%= link_to "Edit", edit_mac_path(mac), class: "btn small" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="empty" data-filter-target="none" hidden>No computer matches.</p>
    </div>
  </section>
<% end %>
