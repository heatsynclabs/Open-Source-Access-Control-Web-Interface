<%= render PageHeaderComponent.new(eyebrow: (can?(:manage, Card) ? "Admin" : "Your account"), title: "Access cards", lead: "Every card the door board knows. Disable a card and upload it before deleting it: deleting here does not remove it from the board.") do |header| %>
  <% header.with_action { link_to "New card", new_card_path, class: "btn primary" } if can? :create, Card %>
  <% header.with_action { link_to "Upload all cards", upload_all_path, class: "btn", data: { confirm: "Send every card to the door board now?" } } if can? :upload_all, Card %>
  <% header.with_action { link_to "Door log", door_logs_path, class: "btn" } if can? :read, DoorLog %>
  <% header.with_action { link_to "Remote door access", space_api_access_path, class: "btn" } if can? :access_doors_remotely, :door_access %>
<% end %>

<% enabled = @cards.count { |card| card.card_permissions == 1 } %>
<div class="tiles">
  <%= render StatTileComponent.new(value: enabled, label: "Cards with access", tone: :headline) %>
  <%= render StatTileComponent.new(value: @cards.size - enabled, label: "Disabled") %>
  <% if @most_active_card&.user %>
    <%= render StatTileComponent.new(value: @most_active_card.accesses_this_week, label: "Days, most active card", sub: @most_active_card.user.name) %>
  <% end %>
  <% if @runner_up_card&.user %>
    <%= render StatTileComponent.new(value: @runner_up_card.accesses_this_week, label: "Days, runner up", sub: @runner_up_card.user.name) %>
  <% end %>
</div>

<div data-controller="filter" data-filter-noun-value="cards">
  <div class="filters">
    <%= render "shared/search", placeholder: "Holder, note or card number", label: "Search cards" %>
    <button type="button" class="toggle" data-filter-target="toggle" data-key="enabled" aria-pressed="false" data-action="filter#flip">With access only</button>
  </div>
  <p class="count-line" data-filter-target="count" aria-live="polite"></p>

  <div class="table-wrap tall">
    <table>
      <thead>
        <tr>
          <th>Holder</th>
          <th>Note</th>
          <th class="num">DB ID</th>
          <th>Card number</th>
          <th>Access</th>
          <th class="num">Days used, last month</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @cards.each do |card| %>
          <tr data-filter-target="item" data-enabled="<%= card.card_permissions == 1 %>"
              data-filter-text="<%= [card.user&.name, card.name, card.card_number].compact.join(' ') %>">
            <td>
              <% if card.user %>
                <%= person_link(card.user, size: 28, to: card) %>
                <%= render MemberBadgeComponent.new(card.user) %>
              <% else %>
                <span class="muted">No holder</span>
              <% end %>
            </td>
            <td class="wrap"><%= card.name %></td>
            <td class="num"><%= card.id %></td>
            <td class="mono"><%= card.card_number %></td>
            <td><%= card.card_permissions == 1 ? render(ChipComponent.new("Access", tone: :ok)) : render(ChipComponent.new("Disabled")) %></td>
            <td class="num"><%= card.accesses_this_week if card.accesses_this_week.to_i > 0 %></td>
            <td class="actions">
              <div class="actions-row">
                <%= link_to "Upload", upload_path(card), class: "btn small" if can? :upload, card %>
                <%= link_to "Edit", edit_card_path(card), class: "btn small" if can? :update, card %>
                <%= link_to "Delete", card, method: :delete, class: "btn small danger",
                      data: { confirm: "Delete this card? This does not remove it from the door board. Disable and upload it first." } if can? :destroy, card %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="empty" data-filter-target="none" hidden>No card matches.</p>
</div>
