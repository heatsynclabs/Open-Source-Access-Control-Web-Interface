<%= render PageHeaderComponent.new(eyebrow: "Access cards", eyebrow_path: cards_path, title: @card.user ? "#{@card.user.name}'s card" : "Card #{@card.card_number}") do |header| %>
  <% header.with_action { link_to "Upload to door", upload_path(@card), class: "btn primary" } if can? :upload, @card %>
  <% header.with_action { link_to "Edit", edit_card_path(@card), class: "btn" } if can? :update, @card %>
<% end %>

<div class="grid side">
  <section class="card">
    <h2>Details</h2>
    <dl class="facts">
      <dt>Holder</dt><dd><%= @card.user ? link_to(@card.user.name, @card.user) : "No holder" %></dd>
      <dt>Note</dt><dd><%= @card.name.presence || "None" %></dd>
      <dt>DB ID (slot)</dt><dd><%= @card.id %></dd>
      <dt>Card number</dt><dd class="mono"><%= @card.card_number %></dd>
      <dt>Access</dt><dd><%= @card.card_permissions == 1 ? render(ChipComponent.new("Enabled", tone: :ok)) : render(ChipComponent.new("Disabled")) %></dd>
    </dl>
  </section>

  <% if can? :read, DoorLog %>
    <section class="card">
      <div class="card-head"><h2>Times it opened the door</h2><span class="muted small"><%= @door_logs.size %></span></div>
      <% if @door_logs.any? %>
        <ul class="plain scroll-box">
          <% @door_logs.each do |log| %>
            <li><span><%= log.created_at.strftime("%a %b %-d, %Y") %></span><span class="muted small"><%= log.created_at.strftime("%-l:%M%P") %></span></li>
          <% end %>
        </ul>
      <% else %>
        <%= render EmptyStateComponent.new("This card has not opened the door.") %>
      <% end %>
    </section>
  <% end %>
</div>
