<%
  # The admin-set welcome text can run long; lead with its first paragraph and
  # link to the rest so the sign-in card and the next steps stay on screen.
  body = Setting.welcome_body.to_s
  first_para = body.split(/<\/p>|\n\s*\n/i).map { |p| Nokogiri::HTML.fragment(p).text.squish }.reject(&:blank?).first.to_s
  lead = truncate(first_para, length: 240, separator: " ")
  longer = Nokogiri::HTML.fragment(body).text.squish.length > lead.length + 20
%>
<% content_for :title, "Welcome" %>
<section class="hero">
  <div>
    <div class="hero-meta">
      <p class="eyebrow">Mesa's community workshop</p>
      <%= render "door_chip" %>
    </div>
    <h1><%= Setting.welcome_title %></h1>
    <% if lead.present? %>
      <p class="lead"><%= lead %> <% if longer %><%= link_to "More about visiting", more_info_path %><% end %></p>
    <% end %>
    <div class="hero-actions">
      <%= link_to "Join the lab", new_user_registration_path, class: "btn primary big" %>
      <%= link_to "Visiting and dues", more_info_path, class: "btn big" %>
    </div>
  </div>

  <div class="card signin">
    <p class="eyebrow">Members</p>
    <h2>Sign in</h2>
    <%= form_for(:user, url: user_session_path) do |f| %>
      <div class="field"><%= f.label :email %><%= f.email_field :email, autocomplete: "username", required: true %></div>
      <div class="field"><%= f.label :password %><%= f.password_field :password, autocomplete: "current-password", required: true %></div>
      <div class="check"><%= f.check_box :remember_me %><%= f.label :remember_me, "Keep me signed in" %></div>
      <%= f.submit "Sign in", class: "wide" %>
    <% end %>
    <p class="note"><%= link_to "Forgot your password?", new_user_password_path %></p>
  </div>
</section>

<section class="steps" aria-labelledby="steps-title">
  <h2 id="steps-title">How joining works</h2>
  <ol class="grid three">
    <li class="step">
      <span class="step-num">01</span>
      <h3>Come by</h3>
      <p>Visit on an open night and look around. Anyone can come; you do not need to be a member.</p>
    </li>
    <li class="step">
      <span class="step-num">02</span>
      <h3>Sign up</h3>
      <p>Make an account here, and sign the <%= link_to "waiver", Contract::ONLINE_FORM_URL %> online or on paper at the lab.</p>
    </li>
    <li class="step">
      <span class="step-num">03</span>
      <h3>Get oriented</h3>
      <p>A member shows you the shop and the house rules. After that you can find other members here and get signed off on tools.</p>
    </li>
  </ol>
</section>

<section class="home-week"><%= render "calendar/week_frame" %></section>

<section class="find">
  <div>
    <p class="eyebrow">Find us</p>
    <p class="find-address"><%= ApplicationHelper::LAB_ADDRESS %></p>
  </div>
  <div class="find-links">
    <%= link_to "Map", ApplicationHelper::LAB_MAP_URL, class: "btn" %>
    <%= link_to "heatsynclabs.org", "https://www.heatsynclabs.org", class: "btn" %>
  </div>
</section>
