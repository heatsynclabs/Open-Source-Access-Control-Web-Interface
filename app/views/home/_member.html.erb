<% content_for :title, "Home" %>
<% can_control = current_user.card_access_enabled && can?(:access_doors_remotely, :door_access) %>
<p class="eyebrow"><%= Time.zone.now.strftime("%A, %B %-d") %></p>
<h1>Hi, <%= current_user.name.to_s.split.first %></h1>

<div class="grid side">
  <div class="stack">
    <% if @steps && @steps.any? { |_what, done, _hint| !done } %>
      <section class="card">
        <h2>Getting started</h2>
        <ul class="checklist">
          <% @steps.each do |what, done, hint| %>
            <li class="<%= 'done' if done %>">
              <span class="box"><%= lucide_icon("check") if done %></span>
              <span>
                <span class="what"><%= what %></span>
                <% unless done %><br><span class="small muted"><%= hint %></span><% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="card">
      <div class="card-head">
        <h2>Doors</h2>
        <%= link_to "Remote door access", space_api_access_path if can_control %>
      </div>
      <% if @door_status && !@door_status[:door_1_locked].nil? %>
        <div class="doors">
          <%= render DoorTileComponent.new(name: "Front door", locked: @door_status[:door_1_locked], open_command: "open-front", can_control: can_control) %>
          <%= render DoorTileComponent.new(name: "Rear door", locked: @door_status[:door_2_locked], open_command: "open-rear", can_control: can_control) %>
        </div>
      <% else %>
        <%= render EmptyStateComponent.new("No door status yet.") %>
      <% end %>
      <%# Door controls only for people with an active card (admins without a card see status only). %>
      <% unless can_control %><p class="note">Door controls come with card access.</p><% end %>
    </section>

    <%= render "calendar/week_frame" %>

    <% if Setting.member_resources_inset.present? %>
      <section class="card prose">
        <h2>Member resources</h2>
        <%= simple_format Setting.member_resources_inset %>
      </section>
    <% end %>
  </div>

  <div class="stack">
    <% if (can? :read, User) && @recent_user_names.present? %>
      <section class="card">
        <div class="card-head">
          <h3>New people <span class="muted small">say hi</span></h3>
          <%= link_to "Everyone", users_path %>
        </div>
        <ul class="plain">
          <% @recent_user_names.each do |user| %>
            <% next unless can? :read, user %>
            <li>
              <%= link_to user, class: "person-cell" do %><%= person_avatar(user, 32) %><span><%= user.name %></span><% end %>
              <span class="small muted nowrap">joined <%= user.created_at.strftime("%b %-d") %></span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @featured_resource.present? %>
      <section class="card">
        <h3>Featured tool</h3>
        <%= render @featured_resource %>
      </section>
    <% end %>
  </div>
</div>
