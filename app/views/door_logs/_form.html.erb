<%= form_for(@door_log, html: { class: "form narrow" }) do |f| %>
  <%= render FormErrorsComponent.new(@door_log) %>
  <fieldset>
    <legend>Log entry</legend>
    <div class="fields">
      <div class="field"><%= f.label :key %><%= f.text_field :key, class: "mono" %></div>
      <div class="field"><%= f.label :data %><%= f.number_field :data %></div>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit class: "primary" %>
    <%= link_to "Cancel", door_logs_path, class: "btn" %>
  </div>
<% end %>
