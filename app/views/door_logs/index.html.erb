<%= render PageHeaderComponent.new(eyebrow: "Admin", title: "Door log", lead: "What the door board recorded: cards read, granted and denied, remote commands, and the lock state it reports every few minutes.") do |header| %>
  <% header.with_action { link_to "Download door logs", download_path, class: "btn", data: { confirm: "Read the door board's log now? The board clears its log after it is read." } } %>
  <% header.with_action { link_to "Access cards", cards_path, class: "btn" } if can? :manage, Card %>
<% end %>

<%= form_tag(nil, method: :get, id: "doorLogFilters", class: "inline-form", data: { controller: "autosubmit" }) do %>
  <div class="field">
    <%= label_tag :type, "Show" %>
    <%= select_tag :type, options_for_select(DoorLog::TYPE_OPTIONS, @door_log_type), data: { action: "autosubmit#submit" } %>
  </div>
  <%= render "shared/date_range", from_label: "Lock chart from" %>
  <%= submit_tag "Update", name: nil, class: "primary" %>
<% end %>

<%# The controller hands lock history as [milliseconds, 1 when unlocked] pairs per door. %>
<% lock_series = [["Front door", @door_log_graph[0]], ["Rear door", @door_log_graph[1]]].map do |name, points| %>
  <% { name: name, data: points.map { |ms, open| [time_from_js(ms), open] } } %>
<% end %>
<%= render ChartCardComponent.new(title: "Doors unlocked",
      note: "From #{@start_date.to_date.strftime('%b %-d')} to #{@end_date.to_date.strftime('%b %-d, %Y')}. Up means unlocked.") do %>
  <% if lock_series.all? { |series| series[:data].empty? } %>
    <%= render EmptyStateComponent.new("No lock reports in these dates.") %>
  <% else %>
    <%= line_chart lock_series, height: "220px", points: false, min: 0, max: 1,
          library: { elements: { line: { stepped: true } }, scales: { y: { ticks: { stepSize: 1 } } } } %>
  <% end %>
<% end %>

<details class="log-guide">
  <summary>What the keys mean</summary>
  <pre>
Card numbers are stored in two parts: cardnum = (R + (r * 32767)), shown in hex.

 A  alarm armed (level)             a  added user (user number)
 C  keypad command (command)        c  second half, or checked user (0 failed, else user number)
 D  denied access (card number)     d  second half, or deleted user (user number)
 E  second                          F  privilege fail (0 wrong password, 1 too many tries, 2 not logged in)
 f  second half, or card fail (user mask)
 G  granted access (card number)    g  second half of card
 H  hour                            i  write to invalid eeprom address (user number)
 I  delete from invalid eeprom address (user number)
 L  locked (1 door 1, 2 door 2, 3 bedtime)
 M  minute                          m  alarm state (level)
 R  read tag (card number)          r  second half of tag
 Q  superuser authed (superuser)    S  auth (0 privileged mode enabled)
 s  alarm sensor (zone)             t  alarm trained (sensor value)
 T  alarm triggered (0)             U  unlocked door (1 door 1, 2 door 2, else card number)
 u  second half of card             Z  user database cleared (0)
 z  log cleared (0)
  </pre>
</details>

<p class="count-line">The latest <%= number_with_delimiter(@door_logs.size) %> entries, newest first.</p>
<div class="table-wrap tall">
  <table class="door-log">
    <thead><tr><th>When</th><th>Key</th><th class="num">Data</th><th>What happened</th></tr></thead>
    <tbody>
      <% door_log_lines(@door_logs).each do |line| %>
        <tr class="<%= line.tone %>">
          <td class="nowrap"><%= line.log.created_at.strftime("%a %b %-d, %Y %-l:%M:%S%P") %></td>
          <td class="mono"><%= line.log.key %></td>
          <td class="num mono"><%= line.log.data %></td>
          <td><% if line.icon %><%= lucide_icon line.icon %> <% end %><%= line.meaning %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
