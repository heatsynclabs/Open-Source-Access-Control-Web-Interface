<%# One person's details, loaded next to the pickers on the merge page. %>
<% user ||= @user %>
<% admin = current_user.admin? %>
<dl class="facts">
  <dt>Name</dt><dd><%= user.name %></dd>
  <% if admin %>
    <dt>Email</dt><dd><%= user.email %></dd>
    <dt>Orientation</dt><dd><%= user.orientation.strftime("%B %-d, %Y") if user.orientation.present? %></dd>
  <% end %>
  <dt>Waiver</dt><dd><%= user.waiver.strftime("%B %-d, %Y") if user.waiver.present? %></dd>
  <dt>Member</dt><dd><%= render MemberBadgeComponent.new(user) %></dd>
  <% if admin %>
    <dt>Level</dt><dd><%= user.member_level %></dd>
    <dt>Pays by</dt><dd><%= user.payment_method %></dd>
    <dt>Payee</dt><dd><%= user.payee %></dd>
    <dt>Phone</dt><dd><%= user.phone %></dd>
  <% end %>
  <dt>Brings</dt><dd><%= simple_format user.current_skills %></dd>
  <dt>Wants</dt><dd><%= simple_format user.desired_skills %></dd>
  <dt>Cards</dt>
  <dd>
    <% if admin %>
      <%= safe_join(user.cards.map { |card| link_to(card.card_number, card) }, ", ") %>
    <% else %>
      <%= "Has a card" if user.cards.present? %>
    <% end %>
  </dd>
  <dt>Certifications</dt><dd><%= user.certifications.any? ? safe_join(user.certifications.map { |cert| link_to(cert.name, cert) }, ", ") : "None" %></dd>
  <% if admin %>
    <dt>Payments</dt><dd><%= user.payments.map(&:date).join(", ").presence || "None" %></dd>
    <dt>Created</dt><dd><%= user.created_at %></dd>
    <dt>Last signed in</dt><dd><%= user.current_sign_in_at %></dd>
  <% end %>
</dl>
