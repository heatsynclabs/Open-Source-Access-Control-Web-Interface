
<style type="text/css">
  /* Member card grid: even, responsive cards that show the full name. */
  .users {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .users .thumbnail {
    float: none;
    width: auto;
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    background: var(--g-raised);
    border: 2px solid var(--g-line-hi);
    border-radius: 0;
    box-shadow: var(--shadow-sm);
  }
  .users .thumbnail:hover { box-shadow: var(--shadow); }
  .users .thumbnail > a:first-child { display: block; line-height: 0; }
  .users .thumbnail img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 0;
    background: var(--g-bg);
  }
  .users .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3px;
    min-height: var(--space-5);
    margin-top: var(--space-2);
  }
  .users .badges img {
    float: none;
    width: 16px;
    height: 16px;
    background: var(--g-bg);
    border-radius: 999px;
  }
  .users .bio {
    margin-top: var(--space-1);
    min-height: var(--space-8);
  }
  .users .bio small {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--ink-faint);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }
  .users .thumbnail h4 {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-snug);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }
  .users .thumbnail h4 a { color: var(--accent-text); }
  .users .thumbnail h4 a:hover { color: var(--hazard); }
</style>

<% if user_signed_in? && current_user.current_sign_in_at < Date.parse("2014-03-01") %>
  <div class="alert alert-info">Looking for the old table view? Find it in the menu under People, Full Table View.</div>
<% end %>

<h1>HeatSync People
<%= link_to 'New User', new_user_path, class: "btn btn-success" if can? :create, User %>
<%= link_to 'Merge Users', users_merge_path, class: "btn btn-primary" if can? :manage, User %>
</h1>


<div class="users">
  <%= render @users %>
</div>

<% if current_user.orientation.blank? then %>
<p class="alert">There's a lot more to see here, but our records show you haven't completed the new member orientation yet. If that's incorrect, please contact a volunteer.</p>
<% end %>

<br />
