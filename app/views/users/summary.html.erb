<div class="g-page">
  <div class="split-head">
    <div>
      <p class="eyebrow">Who's in the lab community</p>
      <h1>People</h1>
    </div>
    <p class="small muted" style="max-width: 46ch; margin: 0">Find someone who knows the thing you're stuck on.</p>
  </div>

  <p>
    <%= link_to 'New User', new_user_path, class: "btn btn-success" if can? :create, User %>
    <%= link_to 'Merge Users', users_merge_path, class: "btn btn-primary" if can? :manage, User %>
    <%= link_to 'Full table', users_path(full: "full"), class: "btn btn-default" %>
  </p>

  <% if current_user.orientation.blank? %>
    <p class="alert">There's a lot more to see here, but our records show you haven't completed the new member orientation yet. If that's incorrect, please contact a volunteer.</p>
  <% end %>

  <% cert_names = @users.flat_map { |u| u.certifications.map(&:name) }.uniq.sort %>
  <div class="filters">
    <label class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/></svg>
      <input id="people-q" type="search" placeholder="Search names, skills, tools" aria-label="Search people">
    </label>
    <button type="button" class="toggle" id="f-cards" aria-pressed="false">Cardholders</button>
    <button type="button" class="toggle" id="f-teach" aria-pressed="false">Instructors</button>
    <select id="f-cert" aria-label="Certified on">
      <option value="">Certified on any tool</option>
      <% cert_names.each do |c| %><option><%= c %></option><% end %>
    </select>
  </div>
  <p class="small muted" id="people-count" aria-live="polite"><%= @users.size %> people</p>

  <ul class="people-list" id="people-list">
    <% @users.each do |user| %>
      <%
        certs = user.certifications.map(&:name).sort
        can_line = first_sentence(user.current_skills)
        wants_line = first_sentence(user.desired_skills)
        cardholder = user.cards.any?
      %>
      <li data-text="<%= [user.name, user.current_skills, user.desired_skills, certs.join(' ')].join(' ').downcase %>"
          data-cards="<%= cardholder %>" data-teach="<%= user.instructor? %>" data-certs="<%= certs.join('|') %>">
        <a class="row" href="<%= user_path(user) %>">
          <%= person_avatar(user, 44) %>
          <div style="min-width:0">
            <div class="who-line">
              <span class="name"><%= user.name %></span>
              <%= raw(user.member_status_symbol) %>
              <% if user.instructor? %><span class="chip info">instructor</span><% end %>
              <% if cardholder %><span class="chip ok">cardholder</span><% end %>
            </div>
            <% if can_line.present? %>
              <div class="skills"><span class="inline-label">Skills</span><%= can_line %></div>
            <% elsif wants_line.present? %>
              <div class="skills"><span class="inline-label">Learning</span><%= wants_line %></div>
            <% end %>
            <% if certs.any? %>
              <div class="tags"><% certs.first(4).each do |c| %><span class="tag"><%= c %></span><% end %><% if certs.size > 4 %><span class="tag">+<%= certs.size - 4 %></span><% end %></div>
            <% end %>
          </div>
          <span class="chev" aria-hidden="true">&rsaquo;</span>
        </a>
      </li>
    <% end %>
  </ul>
  <p class="empty" id="people-none" hidden>Nobody matches. Try fewer words, or clear a filter.</p>
</div>

<script>
  (function () {
    var q = document.getElementById("people-q"), cert = document.getElementById("f-cert");
    var cards = document.getElementById("f-cards"), teach = document.getElementById("f-teach");
    var rows = Array.prototype.slice.call(document.querySelectorAll("#people-list > li"));
    function render() {
      var words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean), shown = 0;
      rows.forEach(function (li) {
        var ok = words.every(function (w) { return li.dataset.text.indexOf(w) !== -1; }) &&
          (cards.getAttribute("aria-pressed") !== "true" || li.dataset.cards === "true") &&
          (teach.getAttribute("aria-pressed") !== "true" || li.dataset.teach === "true") &&
          (!cert.value || li.dataset.certs.split("|").indexOf(cert.value) !== -1);
        li.hidden = !ok; if (ok) shown++;
      });
      document.getElementById("people-count").textContent = shown === rows.length ? rows.length + " people" : shown + " of " + rows.length + " people";
      document.getElementById("people-none").hidden = shown !== 0;
    }
    [cards, teach].forEach(function (b) { b.addEventListener("click", function () { b.setAttribute("aria-pressed", b.getAttribute("aria-pressed") === "true" ? "false" : "true"); render(); }); });
    q.addEventListener("input", render); cert.addEventListener("change", render);
  })();
</script>
