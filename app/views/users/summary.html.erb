<%= render PageHeaderComponent.new(eyebrow: "Who's in the lab community", title: "People", lead: "Find someone who knows the thing you're stuck on.") do |header| %>
  <% header.with_action { link_to "New user", new_user_path, class: "btn small" } if can? :create, User %>
  <% header.with_action { link_to "Merge users", users_merge_path, class: "btn small" } if can? :manage, User %>
<% end %>
<%= render "tabs", current: :summary %>
<%= render "orientation_note" %>

<% cert_names = @users.flat_map { |u| u.certifications.map(&:name) }.uniq.sort %>
<div data-controller="filter" data-filter-noun-value="people">
  <div class="filters">
    <label class="search-box">
      <%= lucide_icon "search" %>
      <input type="search" placeholder="Search names, skills, tools" aria-label="Search people" data-filter-target="query" data-action="filter#apply">
    </label>
    <button type="button" class="toggle" data-filter-target="toggle" data-key="cards" aria-pressed="false" data-action="filter#flip">Cardholders</button>
    <button type="button" class="toggle" data-filter-target="toggle" data-key="teach" aria-pressed="false" data-action="filter#flip">Instructors</button>
    <select aria-label="Certified on" data-filter-target="select" data-key="certs" data-action="filter#apply">
      <option value="">Certified on any tool</option>
      <% cert_names.each do |name| %><option><%= name %></option><% end %>
    </select>
  </div>
  <p class="count-line" data-filter-target="count" aria-live="polite"><%= @users.size %> people</p>

  <ul class="row-list">
    <% @users.each do |user| %>
      <%
        certs = user.certifications.map(&:name).sort
        can_line = first_sentence(user.current_skills)
        wants_line = first_sentence(user.desired_skills)
        cardholder = user.cards.any?
      %>
      <li data-filter-target="item"
          data-filter-text="<%= [user.name, user.current_skills, user.desired_skills, certs.join(' ')].join(' ') %>"
          data-cards="<%= cardholder %>" data-teach="<%= user.instructor? %>" data-certs="<%= certs.join('|') %>">
        <a class="row-link" href="<%= user_path(user) %>">
          <%= person_avatar(user, 44) %>
          <div class="row-main">
            <div class="row-title">
              <span><%= user.name %></span>
              <%= render MemberBadgeComponent.new(user) %>
              <% if user.instructor? %><%= render ChipComponent.new("Instructor", tone: :info) %><% end %>
              <% if cardholder %><%= render ChipComponent.new("Cardholder", tone: :ok) %><% end %>
            </div>
            <% if can_line.present? %>
              <div class="row-sub"><span class="inline-label">Skills</span><%= can_line %></div>
            <% elsif wants_line.present? %>
              <div class="row-sub"><span class="inline-label">Learning</span><%= wants_line %></div>
            <% end %>
            <% if certs.any? %>
              <div class="row-tags">
                <% certs.first(4).each do |name| %><span class="tag"><%= name %></span><% end %>
                <% if certs.size > 4 %><span class="tag">+<%= certs.size - 4 %></span><% end %>
              </div>
            <% end %>
          </div>
          <span class="row-end" aria-hidden="true"><%= lucide_icon "chevron-right" %></span>
        </a>
      </li>
    <% end %>
  </ul>
  <p class="empty" data-filter-target="none" hidden>Nobody matches. Try fewer words, or clear a filter.</p>
</div>
