<%= render PageHeaderComponent.new(eyebrow: "People", eyebrow_path: users_path, title: "Merge two people") %>
<p class="msg warn">Everything except the email, password, name, id, hidden flag and blank values moves to the person you keep, unless they already have a value there. Their cards, certifications and payments move too. The other person is then deleted.</p>

<%= form_tag("/users/merge", method: :post, class: "form") do %>
  <div class="merge-pair">
    <fieldset data-controller="preview" data-preview-url-value="/user_summary/">
      <legend>Keep</legend>
      <div class="field">
        <%= label_tag :user_to_keep, "Person to keep" %>
        <%= collection_select(:user, :to_keep, @users, :id, :name_with_email_and_visibility, { include_blank: true }, { data: { action: "preview#load" } }) %>
      </div>
      <div class="merge-details" id="user_to_keep_details" data-preview-target="panel"></div>
    </fieldset>
    <span class="merge-arrow" aria-hidden="true"><%= lucide_icon "arrow-left" %></span>
    <fieldset data-controller="preview" data-preview-url-value="/user_summary/">
      <legend>Merge in and delete</legend>
      <div class="field">
        <%= label_tag :user_to_merge, "Person to merge" %>
        <%= collection_select(:user, :to_merge, @users, :id, :name_with_email_and_visibility, { include_blank: true }, { data: { action: "preview#load" } }) %>
      </div>
      <div class="merge-details" id="user_to_merge_details" data-preview-target="panel"></div>
    </fieldset>
  </div>
  <div class="form-actions">
    <%= submit_tag "Merge", class: "primary", data: { confirm: "Merge these two people? The second one is deleted." } %>
    <%= link_to "Cancel", users_path, class: "btn" %>
  </div>
<% end %>
