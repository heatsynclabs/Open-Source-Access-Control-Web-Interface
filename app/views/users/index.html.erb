<%= render PageHeaderComponent.new(eyebrow: "People", eyebrow_path: users_path, title: "Full table") do |header| %>
  <% header.with_action { link_to "New user", new_user_path, class: "btn small" } if can? :create, User %>
  <% header.with_action { link_to "Merge users", users_merge_path, class: "btn small" } if can? :manage, User %>
<% end %>
<%= render "tabs", current: :full %>
<%= render "orientation_note" %>

<% @certifications = Certification.all.sort_by(&:id) %>
<% admin = current_user.admin? %>
<% check = lucide_icon("check") %>
<p class="count-line"><%= pluralize(@users.size, "person") %>. Click a heading to sort.</p>
<div class="table-wrap tall">
  <table class="sheet no-stack">
    <thead>
      <tr>
        <th><%= sort_link "Name", "name" %></th>
        <th><%= sort_link "Member", "member" %></th>
        <% if admin %><th>Email</th><% end %>
        <% if admin %><th><%= sort_link "Orientation", "orientation" %></th><% end %>
        <th><%= sort_link "Waiver", "waiver" %></th>
        <th><%= sort_link "Card", "card" %></th>
        <th><%= sort_link "Instructor", "instructor" %></th>
        <% if admin %><th><%= sort_link "Admin", "admin" %></th><% end %>
        <% @certifications.each do |cert| %>
          <th class="vertical"><%= link_to cert.name, request.parameters.merge(sort: "cert", cert: cert.id) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="<%= 'tone-quiet' if user.hidden? %>">
          <td><%= person_link(user, size: 24) %><%= render ChipComponent.new("Hidden") if user.hidden? %></td>
          <td><%= render MemberBadgeComponent.new(user) %></td>
          <% if admin %><td><%= user.email %></td><% end %>
          <% if admin %><td><% if user.orientation.present? %><span title="<%= user.orientation.strftime('%B %d %Y') %>"><%= check %></span><% end %></td><% end %>
          <td><% if user.contracts.present? %><span title="<%= user.contracts.first.signed_at.strftime('%B %d %Y') %>"><%= check %></span><% end %></td>
          <td><%= check if user.cards.present? %></td>
          <td><%= check if user.instructor? %></td>
          <% if admin %><td><%= check if user.admin? %></td><% end %>
          <% @certifications.each do |cert| %>
            <td>
              <% user.user_certifications.select { |uc| uc.certification_id == cert.id }.each do |uc| %>
                <%= link_to check, uc, title: "#{cert.name} certification" %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
