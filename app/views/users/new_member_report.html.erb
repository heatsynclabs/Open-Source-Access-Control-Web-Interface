<%= render PageHeaderComponent.new(eyebrow: "People", eyebrow_path: users_path, title: "New members", lead: "Everyone who joined in the last three months, in their own words. Handy for the welcome email.") %>
<%= render "tabs", current: :new_members %>

<% if @new_users.blank? %>
  <%= render EmptyStateComponent.new("Nobody new in the last three months.") %>
<% else %>
  <% @new_users.sort_by(&:created_at).reverse.group_by { |user| user.created_at.beginning_of_month }.each do |month, users| %>
    <section class="new-members-month">
      <h2><%= month.to_formatted_s(:month_and_year) %> <span class="muted small"><%= pluralize(users.size, "person") %></span></h2>
      <div class="grid two">
        <% users.each do |user| %>
          <article class="card">
            <div class="person-cell new-member-name"><%= person_avatar(user, 36) %><h3><%= user.name %></h3></div>
            <dl class="facts">
              <dt>Brings</dt><dd><%= user.current_skills %></dd>
              <dt>Looking for</dt><dd><%= user.desired_skills %></dd>
              <dt>Found us</dt><dd><%= user.marketing_source %></dd>
            </dl>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
