<style type="text/css">
  .cardholders .thumbnail { text-align: center; padding: 8px; }
  .cardholders .thumbnail img { width: 80px; height: 80px; border-radius: 6px; }
  .cardholders .thumbnail h4 {
    font-size: 12px; margin: 6px 0 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
</style>

<h1>Active Cardholders</h1>
<p class="meta"><%= @cardholders.length %> member<%= 's' unless @cardholders.length == 1 %> with active door access.</p>

<div class="users cardholders row">
  <% @cardholders.each do |user| %>
    <div class="thumbnail col-lg-1 col-sm-2 col-xs-4">
      <%= link_to (image_tag user.gravatar_url(:size => 80, :default => "http://members.heatsynclabs.org/assets/nil.png")), user %>
      <h4><%= link_to user.name, user, :title => user.name %></h4>
    </div>
  <% end %>
</div>
