<%= render PageHeaderComponent.new(eyebrow: "People", eyebrow_path: users_path, title: "Active cardholders", lead: "#{pluralize(@cardholders.length, 'member')} with door access right now.") %>
<%= render "tabs", current: :cardholders %>

<% if @cardholders.empty? %>
  <%= render EmptyStateComponent.new("Nobody holds an active card.") %>
<% else %>
  <ul class="cardholder-grid">
    <% @cardholders.each do |holder| %>
      <%# The gravatar hash comes from SQL so members' emails never reach this page. %>
      <li><%= render AvatarComponent.new(name: holder.name, gravatar_hash: holder.gravatar_hash, size: 72) %><span class="name" title="<%= holder.name %>"><%= holder.name %></span></li>
    <% end %>
  </ul>
<% end %>
