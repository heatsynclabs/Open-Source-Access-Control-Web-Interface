<% admin = current_user.admin? %>
<% content_for :title, @user.name %>
<p class="eyebrow"><%= link_to "People", users_path %></p>
<div class="person-head">
  <%= person_avatar(@user, 72) %>
  <div>
    <h1><%= @user.name %></h1>
    <div class="contact-links">
      <%= render MemberBadgeComponent.new(@user) %>
      <% if @user.instructor? %><%= render ChipComponent.new("Instructor", tone: :info) %><% end %>
      <% if @user.hidden? %><%= render ChipComponent.new("Hidden") %><% end %>
      <% if (admin || @user.email_visible) && @user.email.present? %><%= mail_to @user.email do %><%= lucide_icon "mail" %><%= @user.email %><% end %><% end %>
      <% if (admin || @user.phone_visible) && @user.phone.present? %><%= link_to "tel:#{@user.phone}" do %><%= lucide_icon "phone" %><%= @user.phone %><% end %><% end %>
      <%= render "social_links", user: @user %>
    </div>
  </div>
</div>

<div class="actions-row person-actions">
  <%= link_to user_compose_email_path(@user), class: "btn" do %><%= lucide_icon "send" %> Email <%= @user.name.to_s.split.first %><% end %>
  <%= link_to "Edit", edit_user_path(@user), class: "btn primary" if can? :update, @user %>
  <%= link_to "Delete", @user, method: :delete, class: "btn danger",
        data: { confirm: "Delete this person? This does not remove them from the door system. Disable their cards first." } if can? :destroy, @user %>
</div>

<div class="tiles">
  <% if @user.member_level.to_i >= 25 %>
    <%= render StatTileComponent.new(value: @user.payment_status ? "Paid up" : "Overdue", label: @user.member_level_string, tone: (@user.payment_status ? :headline : :alert)) %>
  <% else %>
    <%= render StatTileComponent.new(value: @user.member_level_string.presence || "None", label: "Membership level") %>
  <% end %>
  <%= render StatTileComponent.new(value: @user.certifications.size, label: "Certifications") %>
  <%= render StatTileComponent.new(value: @user.cards.size, label: "Cards") %>
  <%= render StatTileComponent.new(value: @user.created_at.year, label: "Joined", sub: @user.created_at.strftime("%B %-d, %Y")) %>
</div>

<div class="grid side">
  <div class="stack">
    <section class="card prose">
      <h2>Skills</h2>
      <h3>Brings</h3>
      <%= simple_format @user.current_skills %>
      <h3>Wants to learn</h3>
      <%= simple_format @user.desired_skills %>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>Certifications</h2>
        <%= link_to "Add", new_user_certification_path + "?user=#{@user.id}", class: "btn small" if can? :create, UserCertification %>
      </div>
      <% if @user.certifications.any? %>
        <div class="row-tags"><% @user.certifications.each do |cert| %><%= link_to cert.name, cert, class: "tag" %><% end %></div>
      <% else %>
        <%= render EmptyStateComponent.new("No certifications yet.") %>
      <% end %>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>Tools and resources</h2>
        <%= link_to "Add", new_resource_path, class: "btn small" if can? :create, Resource %>
      </div>
      <% if @user.resources.any? %>
        <div class="tool-grid">
          <% @user.resources.each do |resource| %>
            <%= link_to resource, class: "tool-card #{'gone' if resource.disposed_at}" do %>
              <span class="pic"><%= resource.picture? ? image_tag(resource.picture.url(:thumb), alt: "") : lucide_icon("wrench") %></span>
              <span class="body"><span class="name"><%= resource.name %></span></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <%= render EmptyStateComponent.new("Nothing listed.") %>
      <% end %>
    </section>

    <% if admin %>
      <section class="card prose">
        <h2>Joining and leaving</h2>
        <h3>Found HeatSync through</h3>
        <%= simple_format @user.marketing_source %>
        <h3>Left HeatSync because</h3>
        <%= @user.exit_reason.present? ? simple_format(@user.exit_reason) : tag.p("Not recorded.", class: "empty") %>
      </section>
    <% end %>
  </div>

  <div class="stack">
    <section class="card">
      <h2>Standing</h2>
      <dl class="facts">
        <dt>Waiver</dt>
        <dd>
          <%= @user.waiver.present? ? @user.waiver.strftime("%B %-d, %Y") : "Not on file" %>
          <% @user.contracts.each do |contract| %>
            <br><%= can?(:read, contract) ? link_to("Signed #{contract.signed_at.strftime('%B %-d, %Y')}", contract) : "Signed #{contract.signed_at.strftime('%B %-d, %Y')}" %>
          <% end %>
          <% if can? :create, Contract %><br><%= link_to "Add a waiver", new_contract_path %><% end %>
        </dd>
        <% if admin %>
          <dt>Orientation</dt>
          <dd>
            <%= @user.orientation.present? ? @user.orientation.strftime("%B %-d, %Y") : "Not yet" %>
            <% if @user.oriented_by.present? %><span class="muted small">recorded by <%= link_to @user.oriented_by.name, @user.oriented_by %></span><% end %>
          </dd>
          <dt>Level</dt><dd><%= @user.member_level_string %></dd>
          <dt>Pays by</dt><dd><%= @user.payment_method %></dd>
          <dt>Payee</dt><dd><%= @user.payee %></dd>
        <% end %>
        <dt>Instructor</dt><dd><%= @user.instructor? ? "Yes" : "No" %></dd>
        <% unless admin %>
          <dt>Last payment</dt>
          <dd><% months = @user.delinquency %><%= months < 30 ? "Less than a month ago" : "#{months / 30} months ago" %></dd>
        <% end %>
      </dl>
    </section>

    <% if admin %>
      <section class="card">
        <h2>Emergency contact</h2>
        <dl class="facts">
          <dt>Name</dt><dd><%= @user.emergency_name %></dd>
          <dt>Phone</dt><dd><%= @user.emergency_phone %></dd>
          <dt>Email</dt><dd><%= @user.emergency_email %></dd>
        </dl>
      </section>
    <% end %>

    <section class="card">
      <div class="card-head">
        <h2>Cards</h2>
        <%= link_to "Add", new_card_path + "?user=#{@user.id}", class: "btn small" if can? :create, Card %>
      </div>
      <% if admin %>
        <% if @user.cards.any? %>
          <ul class="plain"><% @user.cards.each do |card| %><li><%= link_to card.card_number, card, class: "mono" %><span class="muted small"><%= card.name %></span></li><% end %></ul>
        <% else %>
          <%= render EmptyStateComponent.new("No cards.") %>
        <% end %>
      <% else %>
        <p><%= @user.cards.any? ? "Has a card" : "No card" %></p>
      <% end %>
    </section>

    <% if admin %>
      <section class="card">
        <h2>Payments</h2>
        <% if @payments.any? %>
          <ul class="plain"><% @payments.each do |payment| %><li><%= link_to payment.date, payment %><span class="muted small"><%= number_to_currency(payment.amount) if payment.amount %></span></li><% end %></ul>
          <p class="note">The latest ten.</p>
        <% else %>
          <%= render EmptyStateComponent.new("No payments recorded.") %>
        <% end %>
      </section>
    <% end %>

    <section class="card">
      <div class="card-head">
        <h2>Computers</h2>
        <%= link_to "Add", new_mac_path, class: "btn small" if can? :create, Mac %>
      </div>
      <% if @user.macs.any? %>
        <ul class="plain"><% @user.macs.each do |mac| %><li><%= link_to mac.mac, mac, class: "mono" %></li><% end %></ul>
      <% else %>
        <%= render EmptyStateComponent.new("None listed.") %>
      <% end %>
    </section>

    <% if admin %>
      <section class="card">
        <h2>Account</h2>
        <dl class="facts">
          <dt>Created</dt><dd><%= @user.created_at.strftime("%B %-d, %Y %-l:%M%P") %></dd>
          <dt>Last signed in</dt><dd><%= @user.current_sign_in_at ? @user.current_sign_in_at.strftime("%B %-d, %Y %-l:%M%P") : "Never" %></dd>
        </dl>
      </section>
    <% end %>
  </div>
</div>
