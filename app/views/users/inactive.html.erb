<%= render PageHeaderComponent.new(eyebrow: "People", eyebrow_path: users_path, title: "Inactive", lead: "People on a paying level who have not paid recently, longest overdue first.") %>
<%= render "tabs", current: :inactive %>

<% admin = current_user.admin? %>
<p class="count-line"><%= pluralize(@users.size, "person") %></p>
<% if @users.blank? %>
  <%= render EmptyStateComponent.new("Everyone on a paying level is up to date.") %>
<% else %>
  <div class="table-wrap tall">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <% if admin %><th>Email</th><% end %>
          <th>Certifications</th>
          <% if admin %><th>Orientation</th><% end %>
          <th>Card</th>
          <th>Pays by</th>
          <th class="num">Level</th>
          <th>Last payment</th>
          <th>Joined</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="<%= 'tone-quiet' if user.hidden? %>">
            <td><%= link_to user, class: "person-cell" do %><%= person_avatar(user, 24) %><span><%= user.name %></span><% end %><%= render ChipComponent.new("Hidden") if user.hidden? %></td>
            <% if admin %><td><%= user.email %></td><% end %>
            <td class="wrap"><%= safe_join(user.certifications.map { |cert| link_to(cert.name, cert) }, ", ") %></td>
            <% if admin %><td><%= user.orientation.strftime("%b %-d, %Y") if user.orientation.present? %></td><% end %>
            <td><%= lucide_icon("check") if user.cards.present? %></td>
            <td><%= user.payment_method %></td>
            <td class="num"><%= user.member_level %></td>
            <td>
              <% delinquency = user.delinquency %>
              <%= delinquency == 9999 ? "No payments" : "#{delinquency / 30} months ago" %>
            </td>
            <td><%= user.created_at.to_date %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<%= render "orientation_note" %>
