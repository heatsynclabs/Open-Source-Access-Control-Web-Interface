<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %></title>
  <%# Apply the saved theme before anything paints, so dark mode never flashes light. %>
  <script>
    try {
      var saved = localStorage.getItem("gantry-theme");
      var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = saved || (prefersDark ? "dark" : "light");
    } catch (e) {}
  </script>
  <link rel="icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_include_tag "legacy" %>
  <%= javascript_importmap_tags %>
  <%= csrf_meta_tags %>
  <%= yield :head %>
</head>
<body data-controller="dialog">
  <a class="skip-link" href="#main">Skip to the page</a>
  <%= render "layouts/header" %>

  <main id="main" class="<%= yield :main_class %>" data-controller="tables">
    <%# Flash text is set by the app itself, some of it with markup (links, line breaks). %>
    <% if notice.present? %><p class="msg ok" role="status"><%= raw notice %></p><% end %>
    <% if alert.present? %><p class="msg err" role="alert"><%= raw alert %></p><% end %>
    <%= yield %>
  </main>

  <footer class="foot">
    <span>HeatSync Labs, Mesa, Arizona</span>
    <%= link_to "heatsynclabs.org", "https://www.heatsynclabs.org" %>
    <%= link_to "Wiki", "https://wiki.heatsynclabs.org" %>
    <%= link_to "Calendar", calendar_path %>
    <%= link_to "Space API", space_api_path %>
  </footer>
<%= raw Setting.analytics_code if Setting.present? %>
</body>
</html>
