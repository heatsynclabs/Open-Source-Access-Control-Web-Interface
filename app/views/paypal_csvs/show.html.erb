<%= render PageHeaderComponent.new(eyebrow: "PayPal imports", eyebrow_path: paypal_csvs_path, title: "PayPal row") %>

<% if @paypal_csv.payment.present? %>
  <p class="msg ok">Linked to a payment. <%= link_to "See the payment", @paypal_csv.payment %>.</p>
<% else %>
  <p class="msg warn">This row could not be linked on its own. Record the payment by hand, or fix the member's email or payee and
    <%= link_to "link email '#{@paypal_csv._from_email_address}' at membership level '#{@paypal_csv._gross.to_i}'", link_paypal_csv_path(@paypal_csv) %>.</p>
<% end %>

<section class="card">
  <dl class="facts">
    <% @paypal_csv.attributes.except("data", "payment_id").each do |name, value| %>
      <dt><%= name.to_s.delete_prefix("_").humanize %></dt>
      <dd><%= value %></dd>
    <% end %>
  </dl>
</section>
