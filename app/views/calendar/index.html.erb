<% content_for :title, "Calendar" %>
<% content_for :main_class, "wide" %>
<%= render PageHeaderComponent.new(eyebrow: "HeatSync Labs", title: "Calendar", lead: "The lab's full event calendar, the same one on heatsynclabs.org.") do |header| %>
  <% header.with_action { link_to "Open on heatsynclabs.org", LabCalendar::PUBLIC_URL, target: "_blank", rel: "noopener", class: "btn small" } %>
<% end %>

<%# The calendar is embedded from the public site so members see one calendar, %>
<%# not a second copy that can drift out of step with it. The embed reports its %>
<%# height so the iframe grows to fit and the page scrolls as one (no scroll box). %>
<div class="calendar-embed" data-controller="calendar-embed">
  <iframe src="<%= LabCalendar::EMBED_URL %>"
          title="HeatSync Labs calendar"
          loading="lazy"
          referrerpolicy="no-referrer"
          data-calendar-embed-target="frame"></iframe>
</div>

<p class="note">The calendar opens on <%= link_to "heatsynclabs.org", LabCalendar::PUBLIC_URL, target: "_blank", rel: "noopener" %> if it does not show above. Times are lab time (Arizona).</p>
