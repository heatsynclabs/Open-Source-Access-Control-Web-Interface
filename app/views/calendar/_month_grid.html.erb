<%# simple_calendar's month layout, as a CSS grid: weekday heads, then a cell per day. %>
<div class="month-grid" role="grid" aria-label="<%= start_date.strftime('%B %Y') %>">
  <% date_range.first(7).each do |day| %>
    <div class="dow" role="columnheader"><%= day.strftime("%a") %></div>
  <% end %>
  <% date_range.each do |day| %>
    <% day_events = calendar.sorted_events_for(day) %>
    <div role="gridcell" class="<%= calendar.td_classes_for(day).join(' ') %>">
      <% instance_exec(day, day_events, &passed_block) %>
      <% if day_events.any? %>
        <span class="dots" aria-hidden="true"><% day_events.first(CalendarHelper::DAY_CELL_EVENTS).each do |event| %><i class="cat-<%= event.category.key %>"></i><% end %></span>
      <% end %>
    </div>
  <% end %>
</div>
