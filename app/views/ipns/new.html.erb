<%= render PageHeaderComponent.new(eyebrow: "PayPal IPN", eyebrow_path: ipns_path, title: "Send a test IPN",
      lead: "Posts a made-up PayPal notification to this site, the way PayPal would. For testing the IPN handler only.") %>
<%= form_tag("/ipns", class: "form") do %>
  <fieldset>
    <legend>Notification fields</legend>
    <div class="fields">
      <div class="field"><%= label_tag :first_name %><%= text_field_tag :first_name, "John", class: "mono" %></div>
      <div class="field"><%= label_tag :last_name %><%= text_field_tag :last_name, "Smith", class: "mono" %></div>
      <div class="field"><%= label_tag :payer_email %><%= text_field_tag :payer_email, "jsmith@example.com", class: "mono" %></div>
      <div class="field"><%= label_tag :item_name %><%= text_field_tag :item_name, "Associate Membership", class: "mono" %></div>
      <div class="field"><%= label_tag :payment_gross %><%= text_field_tag :payment_gross, "25.00", class: "mono" %></div>
      <div class="field"><%= label_tag :transaction_subject %><%= text_field_tag :transaction_subject, "", class: "mono" %></div>
      <div class="field"><%= label_tag :payment_date %><%= text_field_tag :payment_date, "20:46:54 Jun 20, 2013 PDT", class: "mono" %></div>
      <div class="field"><%= label_tag :txn_type %><%= text_field_tag :txn_type, "subscr_payment", class: "mono" %></div>
      <div class="field"><%= label_tag :subscr_id %><%= text_field_tag :subscr_id, "I-1234567890", class: "mono" %></div>
      <div class="field"><%= label_tag :residence_country %><%= text_field_tag :residence_country, "US", class: "mono" %></div>
      <div class="field"><%= label_tag :mc_currency %><%= text_field_tag :mc_currency, "USD", class: "mono" %></div>
      <div class="field"><%= label_tag :business %><%= text_field_tag :business, "hslfinances@gmail.com", class: "mono" %></div>
      <div class="field"><%= label_tag :payment_type %><%= text_field_tag :payment_type, "instant", class: "mono" %></div>
      <div class="field"><%= label_tag :protection_eligibility %><%= text_field_tag :protection_eligibility, "Ineligible", class: "mono" %></div>
      <div class="field"><%= label_tag :verify_sign %><%= text_field_tag :verify_sign, "12ru9021j9f21j90fj1290fj2910fj0219fj0", class: "mono" %></div>
      <div class="field"><%= label_tag :payer_status %><%= text_field_tag :payer_status, "verified", class: "mono" %></div>
      <div class="field"><%= label_tag :txn_id %><%= text_field_tag :txn_id, "1234567890", class: "mono" %></div>
      <div class="field"><%= label_tag :receiver_email %><%= text_field_tag :receiver_email, "hslfinances@gmail.com", class: "mono" %></div>
      <div class="field"><%= label_tag :payer_id %><%= text_field_tag :payer_id, "V812314914", class: "mono" %></div>
      <div class="field"><%= label_tag :receiver_id %><%= text_field_tag :receiver_id, "V90R1280182", class: "mono" %></div>
      <div class="field"><%= label_tag :payment_status %><%= text_field_tag :payment_status, "Completed", class: "mono" %></div>
      <div class="field"><%= label_tag :payment_fee %><%= text_field_tag :payment_fee, "0.85", class: "mono" %></div>
      <div class="field"><%= label_tag :mc_fee %><%= text_field_tag :mc_fee, "0.85", class: "mono" %></div>
      <div class="field"><%= label_tag :mc_gross %><%= text_field_tag :mc_gross, "25.00", class: "mono" %></div>
      <div class="field"><%= label_tag :charset %><%= text_field_tag :charset, "windows-1252", class: "mono" %></div>
      <div class="field"><%= label_tag :notify_version %><%= text_field_tag :notify_version, "3.7", class: "mono" %></div>
      <div class="field"><%= label_tag :ipn_track_id %><%= text_field_tag :ipn_track_id, "9d3d032d9070", class: "mono" %></div>
    </div>
  </fieldset>
  <div class="form-actions"><%= submit_tag "Send test IPN", class: "primary" %></div>
<% end %>
