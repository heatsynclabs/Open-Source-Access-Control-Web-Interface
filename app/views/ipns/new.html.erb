<%# A made-up PayPal notification, field by field, with sample values. %>
<% sample_ipn = {
    first_name: "John",
    last_name: "Smith",
    payer_email: "jsmith@example.com",
    item_name: "Associate Membership",
    payment_gross: "25.00",
    transaction_subject: "",
    payment_date: "20:46:54 Jun 20, 2013 PDT",
    txn_type: "subscr_payment",
    subscr_id: "I-1234567890",
    residence_country: "US",
    mc_currency: "USD",
    business: "hslfinances@gmail.com",
    payment_type: "instant",
    protection_eligibility: "Ineligible",
    verify_sign: "12ru9021j9f21j90fj1290fj2910fj0219fj0",
    payer_status: "verified",
    txn_id: "1234567890",
    receiver_email: "hslfinances@gmail.com",
    payer_id: "V812314914",
    receiver_id: "V90R1280182",
    payment_status: "Completed",
    payment_fee: "0.85",
    mc_fee: "0.85",
    mc_gross: "25.00",
    charset: "windows-1252",
    notify_version: "3.7",
    ipn_track_id: "9d3d032d9070"
} %>
<%= render PageHeaderComponent.new(eyebrow: "PayPal IPN", eyebrow_path: ipns_path, title: "Send a test IPN",
      lead: "Posts a made-up PayPal notification to this site, the way PayPal would. For testing the IPN handler only.") %>
<%= form_tag("/ipns", class: "form") do %>
  <fieldset>
    <legend>Notification fields</legend>
    <div class="fields">
      <% sample_ipn.each do |name, value| %>
        <div class="field"><%= label_tag name %><%= text_field_tag name, value, class: "mono" %></div>
      <% end %>
    </div>
  </fieldset>
  <div class="form-actions"><%= submit_tag "Send test IPN", class: "primary" %></div>
<% end %>
