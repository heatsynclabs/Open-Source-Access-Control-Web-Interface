<%= render PageHeaderComponent.new(eyebrow: "PayPal IPN", eyebrow_path: ipns_path, title: "IPN record") %>

<% if @ipn.payment.present? %>
  <p class="msg ok">Linked to a payment. <%= link_to "See the payment", @ipn.payment %>.</p>
<% else %>
  <p class="msg warn">This record could not be linked on its own. Record the payment by hand, or fix the member's account and try again to
    <%= link_to "link email '#{@ipn.payer_email}' at membership level '#{@ipn.payment_gross.to_i}'", link_ipn_path(@ipn) %>.</p>
<% end %>

<section class="card">
  <dl class="facts">
    <% @ipn.attributes.except("data", "payment_id").each do |name, value| %>
      <dt><%= name.to_s.humanize %></dt>
      <dd><%= value %></dd>
    <% end %>
  </dl>
</section>
