<%= render PageHeaderComponent.new(eyebrow: "Admin", title: "Audit log", lead: "Administrative actions: edits to other members' profiles, certification changes and payment changes. Members editing their own profile are not logged.") %>

<%= form_tag audit_events_path, method: :get, class: "inline-form audit-filters" do %>
  <div class="field">
    <%= label_tag :event_type, "Event type" %>
    <%= select_tag :event_type, options_for_select([["All", ""]] + @event_types.map { |t| [t.tr("_", " "), t] }, params[:event_type]) %>
  </div>
  <div class="field">
    <%= label_tag :affected_user_id, "Affected member id" %>
    <%= text_field_tag :affected_user_id, params[:affected_user_id], inputmode: "numeric" %>
  </div>
  <div class="field">
    <%= label_tag :editor_id, "Editor id" %>
    <%= text_field_tag :editor_id, params[:editor_id], inputmode: "numeric" %>
  </div>
  <%= submit_tag "Filter", class: "primary" %>
  <%= link_to "Reset", audit_events_path, class: "btn" %>
<% end %>

<% if @events.empty? %>
  <%= render EmptyStateComponent.new("No audit events recorded yet.") %>
<% else %>
  <div class="table-wrap tall">
    <table>
      <thead><tr><th>When</th><th>Event</th><th>Editor</th><th>Affected member</th><th>Details</th><th>IP</th></tr></thead>
      <tbody>
        <% @events.each do |e| %>
          <tr>
            <td><%= e.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= render Admin::AuditEventChipComponent.new(e.event_type) %></td>
            <td>
              <% if e.editor_id %>
                <%= link_to (@user_names[e.editor_id] || e.editor_name || "##{e.editor_id}"), user_path(e.editor_id) %>
              <% else %>
                <%= e.editor_name %>
              <% end %>
            </td>
            <td>
              <% if e.affected_user_id %>
                <%= link_to (@user_names[e.affected_user_id] || "user ##{e.affected_user_id}"), user_path(e.affected_user_id) %>
              <% else %>
                <em><%= e.target_label %></em>
              <% end %>
            </td>
            <td class="wrap"><pre class="audit-summary"><%= e.summary %></pre></td>
            <td class="mono"><%= e.ip %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% unless params[:all] %>
  <p class="note">Showing the latest 500. <%= link_to "Show more", audit_events_path(request.query_parameters.merge(all: 1)) %></p>
<% end %>
