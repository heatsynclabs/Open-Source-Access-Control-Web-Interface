<%= render "analytics/history/head", topic: "laser", note: "From the laser log form members fill in at the 80 W laser, read every night (the Laser page in the menu has the settings guide built from the same log). Only logged jobs are here; the month we are in is left out until it is over. Names on the form are never read into the site." %>
<% if @laser&.any? %>
  <% u = @laser %>
  <% months = ->(series) { series.transform_keys { |month| month.strftime("%b %Y") } } %>
  <% t = u.totals %>
  <div class="tiles">
    <%= render StatTileComponent.new(value: number_with_delimiter(t[:jobs]), label: "Jobs logged", sub: "#{t[:first]&.strftime("%b %Y")} to #{t[:last]&.strftime("%b %Y")}", tone: :headline) %>
    <%= render StatTileComponent.new(value: t[:people], label: "People", sub: "#{t[:one_job]} logged one job only") %>
    <%= render StatTileComponent.new(value: number_with_delimiter(t[:hours]), label: "Laser hours") %>
    <%= render StatTileComponent.new(value: "#{t[:busiest_tenth]}%", label: "Jobs by the busiest tenth", sub: "of the people") %>
  </div>
  <p><%= link_to "Laser settings: what worked for each material", laser_path, class: "btn" %></p>
  <div class="grid two">
    <% jobs = months.(u.jobs_by_month) %>
    <%= render ChartCardComponent.new(title: "Jobs a month", rows: jobs, columns: ["Month", "Jobs"]) do %>
      <%= column_chart jobs, discrete: true %>
    <% end %>

    <% people = months.(u.people_by_month) %>
    <%= render ChartCardComponent.new(title: "People using it a month", rows: people, columns: ["Month", "People"]) do %>
      <%= line_chart people, discrete: true, curve: false, points: false %>
    <% end %>

    <% hours = months.(u.hours_by_month) %>
    <%= render ChartCardComponent.new(title: "Laser hours a month", note: "The run time people logged, all copies of a job together.", rows: hours, columns: ["Month", "Hours"]) do %>
      <%= column_chart hours, discrete: true, suffix: " h" %>
    <% end %>

    <% results = u.results_by_year.map { |name, data| { name: name, data: data } } %>
    <%= render ChartCardComponent.new(title: "How jobs turned out, by year", rows: series_rows(results), columns: ["Year", *results.map { |s| s[:name] }]) do %>
      <%= column_chart results, discrete: true, stacked: true %>
    <% end %>

    <% families = u.families_by_year.map { |name, data| { name: name, data: data } } %>
    <%= render ChartCardComponent.new(title: "What was lasered, by year", note: "Jobs by kind of material, after the log's material names are cleaned up.", rows: series_rows(families), columns: ["Year", *families.map { |s| s[:name] }]) do %>
      <%= column_chart families, discrete: true, stacked: true %>
    <% end %>

    <% clean = months.(u.found_clean_by_month) %>
    <%= render ChartCardComponent.new(title: "Found the machine clean", note: "The share of jobs whose maker found the laser clean when they started.", rows: clean, columns: ["Month", "Found clean (%)"]) do %>
      <%= line_chart clean, discrete: true, curve: false, points: false, suffix: "%", max: 100 %>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new("The laser log has not been read on this site yet (docs/laser.md).") %>
<% end %>
