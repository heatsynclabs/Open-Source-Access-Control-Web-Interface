<div class="tiles">
  <%= render StatTileComponent.new(value: @members[:paid_up], label: "Paid up members", sub: "A payment in the last 60 days", tone: :headline) %>
  <%= render StatTileComponent.new(value: @members[:active], label: "On a member level", sub: "Paid up or not; levels stay until someone changes them") %>
  <%= render StatTileComponent.new(value: @members[:cardholders], label: "Hold a working card") %>
  <%= render StatTileComponent.new(value: number_with_delimiter(@door[:entries]), label: "Card swipes", sub: @period.label) %>
  <% if @calendar %>
    <%= render StatTileComponent.new(value: @calendar[:total], label: "Events on the calendar", sub: @period.label) %>
  <% end %>
  <% if @classes %>
    <%= render StatTileComponent.new(value: number_with_delimiter(@classes[:attendees]), label: "Signed up for classes", sub: @period.label) %>
  <% end %>
</div>

<%= render ChartCardComponent.new(title: "Everything together",
      note: "How the lab's numbers rise and fall together. They are counted in very different amounts, so each line is measured against its own busy #{@overview.bucket_name}: 100 is a busy #{@overview.bucket_name} for that number, 50 is half of one. Hover for the real numbers. Click a name to show or hide its line; #{pluralize(@overview.names.size - 4, "more line")} start hidden.#{" All time is shown by quarter (the average month in each)." if @overview.quarterly?}",
      rows: @overview.table, columns: ["When", *@overview.names]) do %>
  <%= line_chart @overview.chart_series, discrete: true, height: "320px", curve: false, points: false, max: Analytics::Overview::CEILING,
        library: { interaction: { mode: "index", intersect: false },
                   scales: { y: { title: { display: true, text: "Against a busy #{@overview.bucket_name} (100)" } } } } %>
<% end %>
