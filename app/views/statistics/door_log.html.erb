<%= render PageHeaderComponent.new(eyebrow: "Your data", eyebrow_path: edit_user_registration_path, title: "Your card at the door", lead: "Only you can see this page.") do |header| %>
  <% header.with_action { link_to "Download JSON", door_statistics_path + ".json", class: "btn" } %>
<% end %>

<% opens_by_day = @door_log_graph.to_h { |ms, count| [time_from_js(ms).to_date, count] } %>
<% if opens_by_day.any? %>
  <%= render ChartCardComponent.new(title: "Days you opened the door", rows: opens_by_day.to_a.reverse, columns: ["Day", "Opens"]) do %>
    <%= column_chart opens_by_day, height: "220px", library: { scales: { y: { ticks: { precision: 0 } } } } %>
  <% end %>
<% end %>

<% if @door_logs.any? %>
  <div class="table-wrap tall stats-table">
    <table>
      <thead><tr><th>When</th><th>What</th><th>Card (hex)</th></tr></thead>
      <tbody>
        <% @door_logs.reverse_each do |log| %>
          <tr><td><%= log.created_at.strftime("%a %b %-d, %Y %-l:%M%P") %></td><td><%= log.key %></td><td class="mono"><%= log.data.to_s(16) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render EmptyStateComponent.new("No door records for your cards yet.") %>
<% end %>
