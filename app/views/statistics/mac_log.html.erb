<%= render PageHeaderComponent.new(eyebrow: "Your data", eyebrow_path: edit_user_registration_path, title: "Your computers at the lab", lead: "Hours your computers were seen on the lab network. Only you can see this page.") do |header| %>
  <% header.with_action { link_to "Download JSON", mac_statistics_path + ".json", class: "btn" } %>
<% end %>

<% series = @mac_log_graph.map { |mac, points| { name: mac, data: points.to_h { |ms, hours| [Time.zone.at(ms / 1000).to_date, hours] } } } %>
<% if series.any? { |s| s[:data].any? } %>
  <%= render ChartCardComponent.new(title: "Hours on the network by day") do %>
    <%= column_chart series, stacked: true, height: "240px", suffix: " h" %>
  <% end %>
<% end %>

<% if @mac_logs.any? %>
  <div class="table-wrap tall stats-table">
    <table>
      <thead><tr><th>When</th><th>What</th><th>MAC</th><th>IP</th></tr></thead>
      <tbody>
        <% @mac_logs.reverse_each do |log| %>
          <tr><td><%= log.created_at.strftime("%a %b %-d, %Y %-l:%M%P") %></td><td><%= log.action %></td><td class="mono"><%= log.mac %></td><td class="mono"><%= log.ip %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render EmptyStateComponent.new("No records for your computers yet.") %>
<% end %>
