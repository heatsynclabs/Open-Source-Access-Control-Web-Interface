<%= render PageHeaderComponent.new(eyebrow: "For other sites and apps", title: "Space status API",
      lead: "The lab's open or closed state in the SpaceAPI format, read from the door locks.") do |header| %>
  <% header.with_action { link_to "JSON", space_api_path(format: :json), class: "btn primary" } %>
  <% header.with_action { link_to "Remote door access", space_api_access_path, class: "btn" } %>
<% end %>

<section class="card">
  <dl class="facts">
    <% @json.each do |key, value| %>
      <dt><%= key.humanize %></dt>
      <dd><%= value.is_a?(Hash) || value.is_a?(Array) ? tag.code(value.to_json) : value %></dd>
    <% end %>
  </dl>
</section>
