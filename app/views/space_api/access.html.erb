<%# Phone-first door control. The form posts back to this page (space_api#access_post)
    with cmd set by the button pressed; signed-out people send user and pass with it. %>
<% content_for :title, "Door access" %>
<%
  status = @status || {}
  doors = [
    { name: "Front door", key: "door_1_locked", locked: status[:door_1_locked], commands: [["Open", "open-front"], ["Unlock", "unlock-front"], ["Lock", "lock-front"]] },
    { name: "Rear door", key: "door_2_locked", locked: status[:door_2_locked], commands: [["Open", "open-rear"], ["Lock", "lock-rear"]] },
  ]
%>
<div class="remote" data-controller="door-status">
  <%= render PageHeaderComponent.new(eyebrow: "HeatSync Labs", title: "Door access") %>

  <% if @output %>
    <p class="msg info" role="status"><%= raw @output %></p>
  <% end %>

  <%= form_tag do %>
    <% unless user_signed_in? %>
      <fieldset>
        <legend>Sign in to use the doors</legend>
        <div class="field"><%= label_tag :user, "Email address" %><%= text_field_tag :user, nil, autocomplete: "username", inputmode: "email" %></div>
        <div class="field"><%= label_tag :pass, "Password" %><%= password_field_tag :pass, nil, autocomplete: "current-password" %></div>
      </fieldset>
    <% end %>

    <div class="doors">
      <% doors.each do |door| %>
        <% state = door[:locked].nil? ? "unknown" : (door[:locked] ? "locked" : "unlocked") %>
        <div class="door <%= state %>" data-door-status-target="door" data-key="<%= door[:key] %>">
          <span class="eyebrow"><%= door[:name] %></span>
          <span class="state"><%= state == "unknown" ? "Unknown" : state.capitalize %></span>
          <div class="actions">
            <% door[:commands].each do |label, command| %>
              <%= button_tag label, name: "cmd", value: command, class: ["btn", ("primary" if command.start_with?("open"))] %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <p class="note">Door state updates every minute.</p>
  <% end %>

  <div class="actions-row remote-extra">
    <button type="button" class="btn" data-action="dialog#open" data-dialog-id="webcams"><%= lucide_icon "video" %> Who's here?</button>
  </div>

  <dialog id="webcams" data-action="click->dialog#backdrop" aria-labelledby="webcams-title">
    <button type="button" class="icon-btn dialog-close" data-action="dialog#close" aria-label="Close"><%= lucide_icon "x" %></button>
    <h2 id="webcams-title">Webcam</h2>
    <a href="http://live.heatsynclabs.org/snapshot.php?camera=1" data-action="door-status#reloadCamera">
      <img class="webcam" src="http://live.heatsynclabs.org/snapshot.php?camera=1" alt="Snapshot from the lab's camera" loading="lazy" data-door-status-target="camera">
    </a>
    <p class="note">Tap the picture for a fresh one.</p>
    <p data-door-status-target="macs"></p>
  </dialog>
</div>
