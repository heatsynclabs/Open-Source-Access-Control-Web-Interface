<% content_for :title, "Forgot your password" %>
<div class="auth-wrap">
  <div class="card auth-card">
    <p class="eyebrow">Members</p>
    <h1>Forgot your password?</h1>
    <p class="muted small">Type the email you signed up with and we will send a link to set a new one.</p>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render FormErrorsComponent.new(resource) %>
      <div class="field"><%= f.label :email %><%= f.email_field :email, autocomplete: "email", autofocus: true %></div>
      <%= f.submit "Send the reset link", class: "wide" %>
    <% end %>
    <%= render "devise/shared/links" %>
  </div>
</div>
