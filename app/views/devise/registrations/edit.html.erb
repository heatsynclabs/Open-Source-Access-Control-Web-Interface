<% welcome = params[:flash] == "welcome_msg" %>
<% payments = can?(:read, resource.payments.first) ? resource.payments.sort_by(&:date).reverse : [] %>
<% content_for :title, "Profile" %>

<div class="person-head">
  <%= person_avatar(resource, 72) %>
  <div>
    <p class="eyebrow">Your profile</p>
    <h1><%= resource.name %></h1>
    <div class="contact-links">
      <%= render MemberBadgeComponent.new(resource) %>
      <span class="small muted"><%= resource.email %></span>
      <%= link_to "Change your photo at Gravatar", "https://www.gravatar.com", class: "small" %>
      <%= link_to "Your public page", user_path(resource), class: "small" if can? :read, resource %>
    </div>
  </div>
</div>

<% if welcome %>
  <div class="msg ok welcome">
    <p><strong>Thank you for becoming a HeatSync Labs member.</strong> Every member matters to this community of learning, science and the arts.</p>
    <p>Start your dues under Dues and payments, or talk to any member. <strong>Recurring electronic payments help a lot:</strong> the lab has no paid staff. If you pay by cash or check, think about paying 3, 6 or 12 months ahead to save volunteers some work.</p>
    <p><strong>To claim member benefits</strong> such as storage, find a volunteer on your next visit or set up a time ahead. Someone will email you soon to book a new member orientation. After that, this site becomes a lot more useful.</p>
    <p><strong>Sign the waiver</strong> before you use the shop: <%= link_to "online waiver", Contract::ONLINE_FORM_URL %>, or on paper at the lab.</p>
    <p>Some privileges, like 24/7 card access, need the community's approval.</p>
    <p>Thanks again, and happy hacking.</p>
  </div>
<% end %>

<div data-controller="tabs" data-tabs-default-value="<%= welcome ? 'dues' : 'details' %>">
  <div class="tabs" role="tablist">
    <button type="button" role="tab" data-tabs-target="tab" data-name="details" data-action="tabs#select">Your details</button>
    <button type="button" role="tab" data-tabs-target="tab" data-name="dues" data-action="tabs#select">Dues and payments <span class="count"><%= payments.size %></span></button>
    <button type="button" role="tab" data-tabs-target="tab" data-name="data" data-action="tabs#select">Your data</button>
  </div>

  <section role="tabpanel" data-tabs-target="panel" data-name="details">
    <%= render partial: "user", locals: { resource: resource, html: { method: :put }, button_label: "Update profile" } %>
  </section>

  <section role="tabpanel" data-tabs-target="panel" data-name="dues" hidden>
    <div class="grid two">
      <%= render "devise/registrations/paying_dues", member: resource %>
      <section class="card">
        <h2>Recorded payments</h2>
        <% if payments.any? %>
          <div class="table-wrap short">
            <table>
              <thead><tr><th>Date</th><th class="num">Amount</th></tr></thead>
              <tbody>
                <% payments.each do |payment| %>
                  <tr><td><%= payment.date.strftime("%B %-d, %Y") %></td><td class="num"><%= number_to_currency(payment.amount) if payment.amount %></td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <%= render EmptyStateComponent.new("No payments recorded yet. The treasurer records them, usually within a few weeks.") %>
        <% end %>
      </section>
    </div>
  </section>

  <section role="tabpanel" data-tabs-target="panel" data-name="data" hidden>
    <%= render "/statistics/index" %>
  </section>
</div>
