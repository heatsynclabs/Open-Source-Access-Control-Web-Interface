<% signing_up = ['new', 'create'].include?(params[:action]) %>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: (html || {}).merge(class: "form")) do |f| %>
  <%= render FormErrorsComponent.new(resource) %>
  <p class="hint">Fields marked * go out on the lab's public mailing list when you join.</p>

  <fieldset>
    <legend>Membership</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :member_level, "Membership level" %>
        <%= f.select :member_level, member_level_options %>
        <p class="hint">Associate $25, Basic $50 or Plus $100 a month.</p>
      </div>
      <div class="field">
        <%= render partial: "/users/payment_methods", locals: { g: f } %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Account</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :name, "Full name *" %>
        <%= f.text_field :name, autocomplete: "name" %>
      </div>
      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: "email" %>
        <div class="check"><%= f.check_box :email_visible %><%= f.label :email_visible, "Show my email to all members" %></div>
      </div>
      <div class="field">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <% unless signing_up %><p class="hint">Only if you want to change it.</p><% end %>
      </div>
      <div class="field">
        <%= f.label :password_confirmation, "Password again" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>
      <% unless signing_up %>
        <div class="field">
          <%= f.label :current_password, "Your current password" %>
          <%= f.password_field :current_password, autocomplete: "current-password" %>
          <p class="hint">Needed to save any change, to keep your account safe.</p>
        </div>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Contact</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :phone %>
        <%= f.text_field :phone, autocomplete: "tel" %>
        <div class="check"><%= f.check_box :phone_visible %><%= f.label :phone_visible, "Show my phone to all members" %></div>
      </div>
      <div class="field">
        <%= f.label :postal_code, "Home postal code" %>
        <%= f.text_field :postal_code, autocomplete: "postal-code" %>
        <p class="hint">We like to know where people commute from.</p>
      </div>
      <div class="field"><%= f.label :twitter_url %><%= f.text_field :twitter_url, placeholder: "https://twitter.com/heatsynclabs" %></div>
      <div class="field"><%= f.label :facebook_url %><%= f.text_field :facebook_url, placeholder: "https://www.facebook.com/HeatSyncLabs" %></div>
      <div class="field"><%= f.label :github_url %><%= f.text_field :github_url, placeholder: "https://github.com/heatsynclabs" %></div>
      <div class="field"><%= f.label :website_url %><%= f.text_field :website_url, placeholder: "https://www.heatsynclabs.org" %></div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Emergency contact</legend>
    <div class="fields">
      <div class="field"><%= f.label :emergency_name, "Name" %><%= f.text_field :emergency_name %></div>
      <div class="field"><%= f.label :emergency_phone, "Phone" %><%= f.text_field :emergency_phone %></div>
      <div class="field"><%= f.label :emergency_email, "Email" %><%= f.text_field :emergency_email %></div>
    </div>
  </fieldset>

  <fieldset>
    <legend>About you</legend>
    <div class="fields">
      <div class="field wide"><%= f.label :current_skills, "What skills, knowledge and experience do you bring to the community? *" %><%= f.text_area :current_skills %></div>
      <div class="field wide"><%= f.label :desired_skills, "What skills, knowledge and experiences are you looking for at HeatSync? *" %><%= f.text_area :desired_skills %></div>
      <div class="field wide"><%= f.label :marketing_source, "How did you find out about HeatSync? *" %><%= f.text_area :marketing_source %></div>
    </div>
  </fieldset>

  <div class="form-actions"><%= f.submit button_label, class: "primary" %></div>
<% end %>
