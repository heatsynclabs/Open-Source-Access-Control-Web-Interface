<% content_for :title, "Resend confirmation" %>
<div class="auth-wrap">
  <div class="card auth-card">
    <p class="eyebrow">Members</p>
    <h1>Resend the confirmation email</h1>
    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f| %>
      <%= render FormErrorsComponent.new(resource) %>
      <div class="field"><%= f.label :email %><%= f.email_field :email, autocomplete: "email" %></div>
      <%= f.submit "Resend confirmation instructions", class: "wide" %>
    <% end %>
    <%= render "devise/shared/links" %>
  </div>
</div>
