<%= render PageHeaderComponent.new(eyebrow: "Payments", eyebrow_path: payments_path,
      title: @payment.amount ? "#{number_to_currency(@payment.amount)} payment" : "Payment") do |header| %>
  <% header.with_action { link_to "Edit", edit_payment_path(@payment), class: "btn" } %>
  <% header.with_action { link_to "Delete", @payment, method: :delete, class: "btn danger", data: { confirm: "Delete this payment?" } } if can? :destroy, @payment %>
<% end %>

<% recorder = @users.find { |u| u.id == @payment.created_by } %>
<div class="grid side">
  <section class="card">
    <h2>Details</h2>
    <dl class="facts">
      <dt>Member</dt>
      <dd><%= @payment.user ? link_to(@payment.user.name_with_payee_and_member_level, @payment.user) : "No member" %></dd>
      <dt>Paid for</dt><dd>The month beginning <%= @payment.date&.strftime("%B %-d, %Y") %></dd>
      <dt>Amount</dt><dd><%= @payment.amount ? number_to_currency(@payment.amount) : "Not recorded" %></dd>
      <dt>Last changed by</dt><dd><%= recorder ? link_to(recorder.name, recorder) : "Not recorded" %></dd>
      <dt>Created</dt><dd><%= @payment.created_at&.strftime("%b %-d, %Y %-l:%M%P") %></dd>
      <dt>Updated</dt><dd><%= @payment.updated_at&.strftime("%b %-d, %Y %-l:%M%P") %></dd>
    </dl>
  </section>
  <% if @payment.ipn.present? || @payment.paypal_csv.present? %>
    <section class="card">
      <h2>Source</h2>
      <ul class="plain">
        <% if @payment.ipn.present? %><li><%= link_to "Paid through PayPal (IPN)", @payment.ipn %></li><% end %>
        <% if @payment.paypal_csv.present? %><li><%= link_to "Paid through PayPal (CSV import)", @payment.paypal_csv %></li><% end %>
      </ul>
    </section>
  <% end %>
</div>
