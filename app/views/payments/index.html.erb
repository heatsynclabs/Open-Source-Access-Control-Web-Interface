<%= render PageHeaderComponent.new(eyebrow: (can?(:create, Payment) ? "Treasurer" : "Your account"), title: "Payments", lead: "Dues recorded for members, by hand or from PayPal. The charts count every payment; the table shows the latest.") do |header| %>
  <% header.with_action { link_to "Record a payment", new_payment_path, class: "btn primary" } if can? :create, Payment %>
  <% header.with_action { link_to "PayPal CSV", paypal_csvs_path, class: "btn" } if can? :manage, PaypalCsv %>
  <% header.with_action { link_to "IPN", ipns_path, class: "btn" } if can? :manage, Ipn %>
<% end %>

<%
  # The controller hands chart data as [milliseconds, value] pairs, one per
  # month, made with Date#to_time in the server's own zone, so read them back
  # in that zone (not lab time, which would land on the previous month).
  by_month = ->(series) { series.map { |ms, value| [Time.at(ms / 1000).to_date, value] } }
  basic = by_month.call(@graph[:basic])
  associate = by_month.call(@graph[:associate])
  members = by_month.call(@graph[:members])
  total = by_month.call(@graph[:total])
  month_label = ->(date) { date.strftime("%b %Y") }
%>

<% if members.any? %>
  <div class="tiles">
    <%= render StatTileComponent.new(value: members.last.last, label: "Paying members, #{month_label.call(members.last.first)}", tone: :headline, sub: ("This month is still filling in" if members.last.first == Date.current.beginning_of_month)) %>
    <%= render StatTileComponent.new(value: number_to_currency(total.last.last, precision: 0), label: "Dues, #{month_label.call(total.last.first)}") %>
    <% if members.size > 1 %>
      <%= render StatTileComponent.new(value: members[-2].last, label: "Paying members, #{month_label.call(members[-2].first)}") %>
    <% end %>
  </div>

  <div class="grid two">
    <%= render ChartCardComponent.new(title: "Dues by month", note: "Basic ($50) and Associate ($25) payments, stacked.",
          rows: basic.zip(associate).map { |(month, b), (_m, a)| [month_label.call(month), [b, a]] }.reverse,
          columns: ["Month", "Basic", "Associate"]) do %>
      <%= column_chart [{ name: "Basic", data: basic }, { name: "Associate", data: associate }],
            stacked: true, prefix: "$", height: "260px" %>
    <% end %>
    <%= render ChartCardComponent.new(title: "Paying members by month", note: "Payments at $25, $50 or $100 in each month.",
          rows: members.map { |month, count| [month_label.call(month), count] }.reverse,
          columns: ["Month", "Members"]) do %>
      <%= line_chart members, height: "260px", points: false %>
    <% end %>
  </div>
<% end %>

<section class="payments-list">
  <div class="split-head">
    <h2>Recorded payments</h2>
    <% if params[:all] %>
      <span class="small muted">All <%= @payments_shown.size %></span>
    <% else %>
      <span class="small muted">Latest 1,000. <%= link_to "Show all", payments_path(all: 1) %></span>
    <% end %>
  </div>
  <div data-controller="filter" data-filter-noun-value="payments">
    <div class="filters">
      <%= render "shared/search", placeholder: "Member, payee or date", label: "Search payments" %>
    </div>
    <p class="count-line" data-filter-target="count" aria-live="polite"></p>
    <div class="table-wrap tall">
      <table>
        <thead>
          <tr><th>Member</th><th>Payee</th><th>Level</th><th>Paid for</th><th class="num">Amount</th><th><span class="visually-hidden">Actions</span></th></tr>
        </thead>
        <tbody>
          <% @payments_shown.each do |payment| %>
            <tr data-filter-target="item" data-filter-text="<%= [payment.user&.name, payment.user&.payee, payment.date].compact.join(' ') %>">
              <td>
                <% if payment.user %>
                  <%= person_link(payment.user, size: 28) %>
                <% else %>
                  <span class="muted">No member</span>
                <% end %>
              </td>
              <td class="muted"><%= payment.user&.payee %></td>
              <td><%= payment.user&.member_level_string %></td>
              <td><%= payment.date&.strftime("%b %-d, %Y") %></td>
              <td class="num"><%= number_to_currency(payment.amount) if payment.amount %></td>
              <td class="actions">
                <div class="actions-row">
                  <%= link_to "Details", payment, class: "btn small" %>
                  <%= link_to "Edit", edit_payment_path(payment), class: "btn small" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="empty" data-filter-target="none" hidden>No payment matches.</p>
  </div>
</section>
