<%= render PageHeaderComponent.new(eyebrow: "Certifications", title: "Certification classes", lead: "The tools and machines that need a checkout before you use them on your own.") do |header| %>
  <% header.with_action { link_to "New certification", new_certification_path, class: "btn primary" } if can? :create, Certification %>
  <% header.with_action { link_to "Who is certified", user_certifications_path, class: "btn" } if can? :read, UserCertification %>
<% end %>

<% if @certifications.any? %>
  <ul class="row-list">
    <% @certifications.each do |certification| %>
      <li>
        <div class="row-item">
          <span class="cert-icon"><%= lucide_icon "graduation-cap" %></span>
          <div class="row-main">
            <div class="row-title"><%= link_to certification.name, certification %></div>
            <div class="row-sub"><span class="mono"><%= certification.slug %></span><% if certification.description.present? %> &middot; <%= certification.description %><% end %></div>
          </div>
          <div class="row-end actions-row">
            <span class="cert-count"><%= pluralize(certification.user_certifications.size, "holder") %></span>
            <%= link_to "Edit", edit_certification_path(certification), class: "btn small" if can? :update, certification %>
            <%= link_to "Delete", certification, method: :delete, class: "btn small danger", data: { confirm: "Delete the #{certification.name} certification?" } if can? :destroy, certification %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render EmptyStateComponent.new("No certification classes yet.") %>
<% end %>
