<%= form_for(@certification, html: { class: "form" }) do |f| %>
  <%= render FormErrorsComponent.new(@certification) %>
  <fieldset>
    <legend>Certification</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :name %>
        <%= f.text_field :name %>
      </div>
      <div class="field">
        <%= f.label :slug %>
        <%= f.text_field :slug, class: "mono", autocomplete: "off" %>
        <p class="hint">Lowercase, one word. Tool interlocks ask for a certification by this name.</p>
      </div>
      <div class="field wide">
        <%= f.label :description %>
        <%= f.text_area :description %>
      </div>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit @certification.new_record? ? "Create certification" : "Save certification", class: "primary" %>
    <%= link_to "Cancel", @certification.new_record? ? certifications_path : certification_path(@certification), class: "btn" %>
  </div>
<% end %>
