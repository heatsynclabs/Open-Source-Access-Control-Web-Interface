<%= render PageHeaderComponent.new(eyebrow: "Tools and resources", eyebrow_path: resources_path, title: @resource.name) do |header| %>
  <% header.with_action { link_to "Edit", edit_resource_path(@resource), class: "btn" } if can? :edit, @resource %>
  <% header.with_action { link_to "Delete", resource_path(@resource), method: :delete, class: "btn danger", data: { confirm: "Delete this tool for good?" } } if can? :destroy, @resource %>
<% end %>

<% pictures = [:picture, :picture2, :picture3, :picture4].map { |name| @resource.send(name) }.reject(&:blank?) %>
<% owner = @resource.user || @resource.owner %>

<div class="grid side">
  <div class="stack">
    <% if pictures.any? %>
      <section class="card">
        <div class="pictures">
          <% pictures.each do |picture| %>
            <%= link_to image_tag(picture.url(:medium), alt: "#{@resource.name} photo", loading: "lazy"), picture.url %>
          <% end %>
        </div>
      </section>
    <% end %>
    <% if @resource.notes.present? %>
      <section class="card prose">
        <h2>Notes</h2>
        <%= simple_format @resource.notes %>
      </section>
    <% end %>
  </div>

  <section class="card">
    <h2>Details</h2>
    <% if @resource.disposed_at %>
      <p class="msg warn">No longer at the lab since <%= @resource.disposed_at.to_date.to_fs(:long) %>.</p>
    <% end %>
    <dl class="facts">
      <% if owner %><dt>Owner</dt><dd><%= @resource.user ? link_to(owner.name, @resource.user) : owner.name %></dd><% end %>
      <dt>Category</dt><dd><%= @resource.resource_category&.name || "None" %></dd>
      <dt>Where</dt><dd><%= @resource.status.presence || "Not given" %></dd>
      <dt>Serial</dt><dd class="mono"><%= @resource.serial.presence || "None" %></dd>
      <dt>Specs</dt><dd><%= @resource.specs.presence || "None" %></dd>
      <dt>Donatable</dt><dd><%= @resource.donatable ? "Yes" : "No" %></dd>
      <dt>Estimated value</dt><dd><%= @resource.estimated_value.presence || "Not given" %></dd>
    </dl>
  </section>
</div>
