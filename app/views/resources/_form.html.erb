<%= form_for @resource, html: { multipart: true, class: "form" } do |f| %>
  <%= render FormErrorsComponent.new(@resource) %>
  <fieldset>
    <legend>The tool</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :name %>
        <%= f.text_field :name %>
      </div>
      <div class="field">
        <%= f.label :resource_category_id, "Category" %>
        <%= select(:resource, :resource_category_id, options_from_collection_for_select(ResourceCategory.all.sort_by(&:name), :id, :name, @resource.resource_category_id), {}) %>
      </div>
      <div class="field">
        <%= f.label :status, "Status / location" %>
        <%= f.text_field :status %>
        <p class="hint">A room, a shelf, or its condition.</p>
      </div>
      <div class="field">
        <%= f.label :serial %>
        <%= f.text_field :serial, class: "mono" %>
      </div>
      <div class="field wide">
        <%= f.label :specs %>
        <%= f.text_field :specs %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Ownership</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :user_id, "Owner" %>
        <%= select(:resource, :user_id, options_from_collection_for_select(@users, :id, :name, @resource.user_id), { include_blank: true }) %>
        <p class="hint">Leave blank when the lab owns it.</p>
      </div>
      <div class="field">
        <%= f.label :estimated_value, "Estimated value" %>
        <%= f.text_field :estimated_value %>
      </div>
      <div class="field">
        <%= f.label :disposed_at, "Gone since" %>
        <div class="date-select"><%= f.date_select :disposed_at, include_blank: true %></div>
        <p class="hint">Set when the tool leaves the lab.</p>
      </div>
      <div class="field">
        <span class="label">Donations</span>
        <div class="check"><%= f.check_box :donatable %><%= f.label :donatable, "Can be donated" %></div>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Photos</legend>
    <div class="fields">
      <% [:picture, :picture2, :picture3, :picture4].each_with_index do |name, i| %>
        <div class="field photo-field">
          <%= f.label name, "Photo #{i + 1}" %>
          <% unless @resource.send(name).blank? %>
            <%= link_to image_tag(@resource.send(name).url(:tiny), alt: "Current photo #{i + 1}"), @resource.send(name).url, class: "current-photo" %>
          <% end %>
          <%= f.file_field name %>
        </div>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Notes</legend>
    <div class="field wide">
      <%= f.label :notes %>
      <%= f.text_area :notes %>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit @resource.new_record? ? "Add tool" : "Save tool", class: "primary" %>
    <%= link_to "Cancel", @resource.new_record? ? resources_path : resource_path(@resource), class: "btn" %>
  </div>
<% end %>
