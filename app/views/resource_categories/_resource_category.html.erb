<li>
  <div class="row-item">
    <span class="row-icon"><%= lucide_icon "folder" %></span>
    <div class="row-main">
      <div class="row-title"><%= resource_category.name %></div>
      <div class="row-sub"><%= pluralize(resource_category.resources.count, "tool") %></div>
    </div>
    <div class="row-end actions-row">
      <%= link_to "Edit", [:edit, resource_category], class: "btn small" if can? :edit, resource_category %>
      <%= link_to "Delete", resource_category, method: :delete, class: "btn small danger", data: { confirm: "Delete the #{resource_category.name} category for good?" } if can? :destroy, resource_category %>
    </div>
  </div>
</li>
