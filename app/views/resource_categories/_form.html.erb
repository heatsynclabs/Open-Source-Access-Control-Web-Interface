<%= form_for @resource_category, html: { multipart: true, class: "form narrow" } do |f| %>
  <%= render FormErrorsComponent.new(@resource_category) %>
  <fieldset>
    <legend>Category</legend>
    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name %>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit @resource_category.new_record? ? "Add category" : "Save category", class: "primary" %>
    <%= link_to "Cancel", resource_categories_path, class: "btn" %>
  </div>
<% end %>
