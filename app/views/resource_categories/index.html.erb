<%= render PageHeaderComponent.new(eyebrow: "Tools and resources", eyebrow_path: (resources_path if can?(:read, Resource)), title: "Categories") do |header| %>
  <% header.with_action { link_to "Add a category", new_resource_category_path, class: "btn primary" } if can? :create, ResourceCategory %>
<% end %>

<% if @resource_categories.any? %>
  <ul class="row-list">
    <%= render @resource_categories.sort_by(&:name) %>
  </ul>
<% else %>
  <%= render EmptyStateComponent.new("No categories yet.") %>
<% end %>
<p class="note">A category with tools in it cannot be deleted. Move its tools first.</p>
