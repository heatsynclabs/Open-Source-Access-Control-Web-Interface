<%= render PageHeaderComponent.new(eyebrow: "Certifications", eyebrow_path: certifications_path, title: "All sign-offs", lead: "Every certification on record, newest first.") do |header| %>
  <% header.with_action { link_to "Certify someone", new_user_certification_path, class: "btn primary" } if can? :create, UserCertification %>
<% end %>

<div data-controller="filter" data-filter-noun-value="sign-offs">
  <div class="filters">
    <%= render "shared/search", placeholder: "Member, tool or instructor", label: "Search sign-offs" %>
  </div>
  <p class="count-line" data-filter-target="count" aria-live="polite"></p>

  <% if @sign_offs.any? %>
    <div class="table-wrap tall">
      <table>
        <thead><tr><th>When</th><th>Member</th><th>Tool</th><th>Signed off by</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <% @sign_offs.each do |sign_off| %>
            <% by = @signed_off_by[sign_off.created_by] %>
            <tr data-filter-target="item" data-filter-text="<%= [sign_off.user_name, sign_off.certification&.name, by].compact.join(' ') %>">
              <td class="nowrap"><%= link_to sign_off.created_at.strftime("%b %-d, %Y"), sign_off %></td>
              <td><%= sign_off.user ? link_to(sign_off.user_name, sign_off.user) : sign_off.user_name %></td>
              <td><%= sign_off.certification ? link_to(sign_off.certification.name, sign_off.certification) : "Missing tool" %></td>
              <td><%= by %></td>
              <td class="actions">
                <%= link_to "Remove", sign_off, method: :delete, class: "btn small danger",
                      data: { confirm: "Remove this certification?" } if can? :destroy, sign_off %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="empty" data-filter-target="none" hidden>Nothing matches.</p>
  <% else %>
    <%= render EmptyStateComponent.new("Nobody is certified on anything yet.") %>
  <% end %>
</div>
