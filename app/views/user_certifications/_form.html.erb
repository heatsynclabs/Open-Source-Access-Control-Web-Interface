<% @user_certification.user_id = params[:user] if params[:user].present? %>
<%= form_for(@user_certification, html: { class: "form" }) do |f| %>
  <%= render FormErrorsComponent.new(@user_certification) %>
  <fieldset>
    <legend>Certification</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :user_id, "Member" %>
        <%= collection_select(:user_certification, :user_id, @users, :id, :name, include_blank: true) %>
      </div>
      <div class="field">
        <%= f.label :certification_id, "Certification" %>
        <%= collection_select(:user_certification, :certification_id, @certifications, :id, :name, include_blank: true) %>
      </div>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit @user_certification.new_record? ? "Certify" : "Save", class: "primary" %>
    <%= link_to "Cancel", @user_certification.new_record? ? user_certifications_path : user_certification_path(@user_certification), class: "btn" %>
  </div>
<% end %>
