<% signer = [@contract.first_name, @contract.last_name].compact_blank.join(" ") %>
<%= render PageHeaderComponent.new(eyebrow: "Waivers", eyebrow_path: contracts_path, title: signer.presence || "Waiver") do |header| %>
  <% header.with_action { link_to "Edit", edit_contract_path(@contract), class: "btn" } %>
  <% header.with_action { link_to "New waiver", new_contract_path, class: "btn" } %>
  <% header.with_action { link_to "Delete", contract_path(@contract), method: :delete, class: "btn danger", data: { confirm: "Delete this waiver for good?" } } if can? :destroy, @contract %>
<% end %>

<div class="grid side">
  <section class="card">
    <h2>Details</h2>
    <dl class="facts">
      <dt>Signed by</dt><dd><%= signer %><%= " and #{@contract.cosigner}" if @contract.cosigner.present? %></dd>
      <dt>Member</dt><dd><%= @contract.user ? link_to(@contract.user.name, @contract.user) : "Not linked" %></dd>
      <dt>Signed</dt><dd><%= @contract.signed_at ? @contract.signed_at.to_date.to_fs(:long) : "Unknown" %></dd>
      <% if @contract.created_by %><dt>Entered by</dt><dd><%= @contract.created_by.name %></dd><% end %>
    </dl>
  </section>

  <section class="card">
    <h2>Scan</h2>
    <% if @contract.document.blank? %>
      <%= render EmptyStateComponent.new("No document uploaded.") %>
    <% else %>
      <% begin %>
        <p><%= link_to "Download", @contract.document.url, class: "btn small" %></p>
        <div class="contract-doc">
          <iframe src="<%= @contract.document.url %>" title="Signed waiver document"></iframe>
        </div>
      <% rescue StandardError %>
        <p class="empty">The signed document could not be loaded here.</p>
      <% end %>
    <% end %>
  </section>
</div>
