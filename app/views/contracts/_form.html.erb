<%= form_for(@contract, html: { class: "form" }) do |f| %>
  <%= render FormErrorsComponent.new(@contract) %>
  <fieldset>
    <legend>Who signed</legend>
    <div class="fields">
      <div class="field">
        <%= f.label :first_name %>
        <%= f.text_field :first_name %>
      </div>
      <div class="field">
        <%= f.label :last_name %>
        <%= f.text_field :last_name %>
      </div>
      <div class="field">
        <%= f.label :cosigner %>
        <%= f.text_field :cosigner %>
        <p class="hint">A parent or guardian signing for a minor.</p>
      </div>
      <div class="field">
        <%= f.label :user_id, "Member" %>
        <%= collection_select(:contract, :user_id, @users, :id, :name, include_blank: true) %>
        <div id="contract_user_notes"></div>
      </div>
      <div class="field">
        <%= f.label :signed_at, "Signed on" %>
        <div class="date-select"><%= f.date_select :signed_at %></div>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Scan</legend>
    <div class="field wide">
      <% if @contract.document.present? %>
        <p><%= link_to "View the document on file", @contract.document.url, class: "btn small", target: "_blank", rel: "noopener" %></p>
        <details class="replace-document">
          <summary>Upload a new document</summary>
          <%= f.label :document, "New document" %>
          <%= f.file_field :document %>
        </details>
      <% else %>
        <%= f.label :document %>
        <%= f.file_field :document %>
        <p class="hint">A photo or PDF of the signed paper waiver.</p>
      <% end %>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit @contract.new_record? ? "Save waiver" : "Save changes", class: "primary" %>
    <%= link_to "Cancel", @contract.new_record? ? contracts_path : contract_path(@contract), class: "btn" %>
  </div>
<% end %>
