<section class="card week-card">
  <div class="card-head">
    <h2>This week at the lab</h2>
    <%= link_to "Full calendar", helpers.calendar_path %>
  </div>
  <ol class="week-days">
    <% @days.each do |day| %>
      <li class="week-day <%= 'today' if day == Date.current %> <%= 'quiet' if nothing_on?(day) %>">
        <div class="week-day-head">
          <span class="dow"><%= event_day_label(day) %></span>
          <span class="date"><%= day.strftime("%b %-d") %></span>
        </div>
        <% open_hours_on(day).each do |open| %>
          <p class="open-line"><%= helpers.lucide_icon("door-open") %> Open <%= event_time_range(open) %></p>
        <% end %>
        <% events_on(day).each do |event| %>
          <%= render Calendar::EventComponent.new(event: event) %>
        <% end %>
        <% if nothing_on?(day) %><p class="empty small">Nothing listed</p><% end %>
      </li>
    <% end %>
  </ol>
  <%= render Calendar::EventDialogComponent.with_collection(@events.reject { |e| e.category.key == "open" }.uniq) %>
</section>
