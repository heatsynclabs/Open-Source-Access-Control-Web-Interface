<section class="card week-card">
  <div class="card-head">
    <h2>This week at the lab</h2>
    <%= link_to "Full calendar", calendar_path %>
  </div>
  <ol class="week-days">
    <% shown_days.each do |day| %>
      <li class="week-day <%= 'today' if day == Date.current %>">
        <time class="day-badge" datetime="<%= day.iso8601 %>" title="<%= day.strftime('%A, %B %-d') %>">
          <span class="dow"><%= day == Date.current ? "Today" : day.strftime("%a") %></span>
          <span class="dom"><%= day.day %></span>
        </time>
        <div class="day-body">
          <% open_hours_on(day).each do |open| %>
            <p class="open-line">Open <%= event_time_range(open) %></p>
          <% end %>
          <% events_on(day).each do |event| %>
            <%= render Calendar::EventComponent.new(event: event, style: :line) %>
          <% end %>
          <% if events_on(day).empty? && open_hours_on(day).empty? %><p class="empty small">Nothing listed today</p><% end %>
        </div>
      </li>
    <% end %>
  </ol>
  <% if shown_days.size < @days.count %>
    <p class="note">Days with nothing listed are left out.</p>
  <% end %>
  <%= render Calendar::EventDialogComponent.with_collection(listed_events) %>
</section>
