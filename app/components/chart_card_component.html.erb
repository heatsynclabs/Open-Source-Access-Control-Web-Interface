<section class="card chart-card">
  <h3><%= @title %></h3>
  <% if @note %><p class="note chart-note"><%= @note %></p><% end %>
  <div class="chart-body"><%= content %></div>
  <% if @rows.present? && @columns %>
    <details class="chart-data">
      <summary>The numbers</summary>
      <div class="table-wrap">
        <table>
          <thead><tr><% @columns.each_with_index do |column, i| %><th class="<%= 'num' if i > 0 %>"><%= column %></th><% end %></tr></thead>
          <tbody>
            <% table_rows.each do |key, value| %>
              <tr>
                <td><%= key %></td>
                <% Array(value).each do |cell| %><td class="num"><%= cell.is_a?(Numeric) ? number_with_delimiter(cell.round(2)) : cell %></td><% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  <% end %>
</section>
